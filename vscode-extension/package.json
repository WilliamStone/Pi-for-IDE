{
  "name": "pi-for-ide",
  "displayName": "Pi for IDE",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "WilliamStone",
  "license": "MIT",
  "icon": "resources/icons/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WilliamStone/Pi-for-IDE.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "chat",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:piIde.sessions"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piIde.open",
        "title": "%cmd.open%",
        "category": "Pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.start",
        "title": "%cmd.start%",
        "category": "Pi for IDE",
        "icon": "$(debug-start)"
      },
      {
        "command": "piIde.reveal",
        "title": "%cmd.reveal%",
        "category": "Pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.stop",
        "title": "%cmd.stop%",
        "category": "Pi for IDE",
        "icon": "$(debug-stop)"
      },
      {
        "command": "piIde.openInBrowser",
        "title": "%cmd.openInBrowser%",
        "category": "Pi for IDE",
        "icon": "$(globe)"
      },
      {
        "command": "piIde.mentionFile",
        "title": "%cmd.mentionFile%",
        "category": "Pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.mentionSelection",
        "title": "%cmd.mentionSelection%",
        "category": "Pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.upgrade",
        "title": "%cmd.upgrade%",
        "category": "Pi for IDE",
        "icon": "$(cloud-download)"
      },
      {
        "command": "piIde.versions",
        "title": "%cmd.versions%",
        "category": "Pi for IDE",
        "icon": "$(versions)"
      },
      {
        "command": "piIde.session.open",
        "title": "%cmd.session.open%",
        "category": "Pi for IDE",
        "icon": "$(comment)"
      },
      {
        "command": "piIde.session.rename",
        "title": "%cmd.session.rename%",
        "category": "Pi for IDE",
        "icon": "$(edit)"
      },
      {
        "command": "piIde.session.fork",
        "title": "%cmd.session.fork%",
        "category": "Pi for IDE",
        "icon": "$(repo-forked)"
      },
      {
        "command": "piIde.session.delete",
        "title": "%cmd.session.delete%",
        "category": "Pi for IDE",
        "icon": "$(trash)"
      },
      {
        "command": "piIde.session.pin",
        "title": "%cmd.session.pin%",
        "category": "Pi for IDE",
        "icon": "$(pin)"
      },
      {
        "command": "piIde.session.unpin",
        "title": "%cmd.session.unpin%",
        "category": "Pi for IDE",
        "icon": "$(pinned)"
      },
      {
        "command": "piIde.session.archive",
        "title": "%cmd.session.archive%",
        "category": "Pi for IDE",
        "icon": "$(archive)"
      },
      {
        "command": "piIde.session.unarchive",
        "title": "%cmd.session.unarchive%",
        "category": "Pi for IDE",
        "icon": "$(archive)"
      },
      {
        "command": "piIde.sessions.refresh",
        "title": "%cmd.sessions.refresh%",
        "category": "Pi for IDE",
        "icon": "$(refresh)"
      },
      {
        "command": "piIde.sessions.filterWorkspace",
        "title": "%cmd.sessions.filterWorkspace%",
        "category": "Pi for IDE",
        "icon": "$(home)"
      },
      {
        "command": "piIde.sessions.showAll",
        "title": "%cmd.sessions.showAll%",
        "category": "Pi for IDE",
        "icon": "$(globe)"
      },
      {
        "command": "piIde.sessions.newSession",
        "title": "%cmd.sessions.newSession%",
        "category": "Pi for IDE",
        "icon": "$(add)"
      },
      {
        "command": "piIde.sessions.cycleViewMode",
        "title": "%cmd.sessions.cycleViewMode%",
        "category": "Pi for IDE",
        "icon": "$(list-tree)"
      },
      {
        "command": "piIde.project.pin",
        "title": "%cmd.project.pin%",
        "category": "Pi for IDE",
        "icon": "$(pin)"
      },
      {
        "command": "piIde.project.unpin",
        "title": "%cmd.project.unpin%",
        "category": "Pi for IDE",
        "icon": "$(pinned)"
      },
      {
        "command": "piIde.project.rename",
        "title": "%cmd.project.rename%",
        "category": "Pi for IDE",
        "icon": "$(edit)"
      },
      {
        "command": "piIde.project.newSession",
        "title": "%cmd.project.newSession%",
        "category": "Pi for IDE",
        "icon": "$(add)"
      },
      {
        "command": "piIde.openOriginal",
        "title": "%cmd.openOriginal%",
        "category": "Pi for IDE",
        "icon": "$(window)"
      },
      {
        "command": "piIde.settings",
        "title": "%cmd.settings%",
        "category": "Pi for IDE",
        "icon": "$(settings-gear)"
      },
      {
        "command": "piIde.sessions.editProjectSettings",
        "title": "%cmd.sessions.editWorkspaceSettings%",
        "category": "Pi for IDE",
        "icon": "$(json)"
      },
      {
        "command": "piIde.sessions.editProjectSettingsHere",
        "title": "%cmd.sessions.editProjectSettings%",
        "icon": "$(json)"
      },
      {
        "command": "piIde.session.openFull",
        "title": "%cmd.session.openFull%",
        "category": "Pi for IDE",
        "icon": "$(layout)"
      },
      {
        "command": "piIde.session.revealInExplorer",
        "title": "%cmd.session.revealInExplorer%",
        "category": "Pi for IDE",
        "icon": "$(folder-opened)"
      },
      {
        "command": "piIde.session.openInNewWindow",
        "title": "%cmd.session.openInNewWindow%",
        "category": "Pi for IDE",
        "icon": "$(empty-window)"
      },
      {
        "command": "piIde.session.openInTerminal",
        "title": "%cmd.session.openInTerminal%",
        "category": "Pi for IDE",
        "icon": "$(terminal)"
      },
      {
        "command": "piIde.session.openInWorkspaceWindow",
        "title": "%cmd.session.openInWorkspaceWindow%",
        "category": "Pi for IDE",
        "icon": "$(empty-window)"
      },
      {
        "command": "piIde.project.openInWindow",
        "title": "%cmd.project.openInWindow%",
        "category": "Pi for IDE",
        "icon": "$(empty-window)"
      },
      {
        "command": "piIde.session.copyWorkspacePath",
        "title": "%cmd.session.copyWorkspacePath%",
        "category": "Pi for IDE",
        "icon": "$(copy)"
      },
      {
        "command": "piIde.project.copyWorkspacePath",
        "title": "%cmd.project.copyWorkspacePath%",
        "category": "Pi for IDE",
        "icon": "$(copy)"
      },
      {
        "command": "piIde.tab.copyWorkspacePath",
        "title": "%cmd.tab.copyWorkspacePath%",
        "category": "Pi for IDE",
        "icon": "$(copy)"
      },
      {
        "command": "piIde.tab.revealInSessions",
        "title": "%cmd.tab.revealInSessions%",
        "category": "Pi for IDE",
        "icon": "$(list-tree)"
      },
      {
        "command": "piIde.tab.reloadPage",
        "title": "%cmd.tab.reloadPage%",
        "category": "Pi for IDE",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piIde",
          "title": "%view.container.piIde%",
          "icon": "resources/icons/activity.svg"
        }
      ]
    },
    "views": {
      "piIde": [
        {
          "id": "piIde.sessions",
          "name": "%view.container.piIde%",
          "icon": "resources/icons/activity.svg",
          "contextualTitle": "Pi Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "piIde.sessions",
        "contents": "%viewWelcome.sessions%"
      }
    ],
    "configuration": {
      "title": "Pi for IDE",
      "properties": {
        "Pi for IDE.executablePath": {
          "type": "string",
          "default": "",
          "description": "%config.executablePath%"
        },
        "Pi for IDE.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "%config.workspaceRoot%"
        },
        "Pi for IDE.sessionTabs": {
          "type": "string",
          "enum": [
            "perSession",
            "single"
          ],
          "default": "perSession",
          "description": "%config.sessionTabs%"
        },
        "Pi for IDE.sessions.titleMaxWidth": {
          "type": "number",
          "default": 32,
          "minimum": 0,
          "description": "%config.sessions.titleMaxWidth%"
        },
        "Pi for IDE.sessions.metaLayout": {
          "type": "string",
          "enum": [
            "line",
            "inline"
          ],
          "default": "line",
          "description": "%config.sessions.metaLayout%"
        },
        "Pi for IDE.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "%config.openBeside%"
        },
        "Pi for IDE.port": {
          "type": "number",
          "default": 3030,
          "minimum": 1,
          "maximum": 65535,
          "description": "%config.port%"
        },
        "Pi for IDE.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoStart%"
        },
        "Pi for IDE.autoStop": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoStop%"
        },
        "Pi for IDE.autoStopAfterSec": {
          "type": "number",
          "default": 300,
          "minimum": 90,
          "description": "%config.autoStopAfterSec%"
        },
        "Pi for IDE.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%config.checkForUpdates%"
        },
        "Pi for IDE.package": {
          "type": "string",
          "default": "@william_stone/pi-web-for-ide",
          "description": "%config.package%"
        },
        "Pi for IDE.localPackage": {
          "type": "string",
          "default": "",
          "description": "%config.localPackage%"
        },
        "Pi for IDE.installSource": {
          "type": "string",
          "enum": [
            "auto",
            "prefer-remote",
            "local",
            "registry"
          ],
          "default": "auto",
          "description": "%config.installSource%"
        },
        "Pi for IDE.notifyAwaiting": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyAwaiting%"
        },
        "Pi for IDE.showOpenInBrowser": {
          "type": "boolean",
          "default": true,
          "description": "%config.showOpenInBrowser%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "piIde.open"
        },
        {
          "command": "piIde.start"
        },
        {
          "command": "piIde.stop"
        },
        {
          "command": "piIde.reveal",
          "when": "false"
        },
        {
          "command": "piIde.mentionFile",
          "when": "false"
        },
        {
          "command": "piIde.mentionSelection",
          "when": "false"
        },
        {
          "command": "piIde.session.open",
          "when": "false"
        },
        {
          "command": "piIde.session.rename",
          "when": "false"
        },
        {
          "command": "piIde.session.fork",
          "when": "false"
        },
        {
          "command": "piIde.session.delete",
          "when": "false"
        },
        {
          "command": "piIde.session.pin",
          "when": "false"
        },
        {
          "command": "piIde.session.unpin",
          "when": "false"
        },
        {
          "command": "piIde.session.archive",
          "when": "false"
        },
        {
          "command": "piIde.session.unarchive",
          "when": "false"
        },
        {
          "command": "piIde.sessions.newSession",
          "when": "false"
        },
        {
          "command": "piIde.sessions.refresh",
          "when": "false"
        },
        {
          "command": "piIde.sessions.filterWorkspace",
          "when": "false"
        },
        {
          "command": "piIde.sessions.editProjectSettingsHere",
          "when": "false"
        },
        {
          "command": "piIde.sessions.showAll",
          "when": "false"
        },
        {
          "command": "piIde.project.pin",
          "when": "false"
        },
        {
          "command": "piIde.project.unpin",
          "when": "false"
        },
        {
          "command": "piIde.project.rename",
          "when": "false"
        },
        {
          "command": "piIde.project.newSession",
          "when": "false"
        },
        {
          "command": "piIde.openOriginal"
        },
        {
          "command": "piIde.settings"
        },
        {
          "command": "piIde.session.openFull",
          "when": "false"
        },
        {
          "command": "piIde.session.revealInExplorer",
          "when": "false"
        },
        {
          "command": "piIde.session.openInNewWindow",
          "when": "false"
        },
        {
          "command": "piIde.session.openInTerminal",
          "when": "false"
        },
        {
          "command": "piIde.session.openInWorkspaceWindow",
          "when": "false"
        },
        {
          "command": "piIde.project.openInWindow",
          "when": "false"
        },
        {
          "command": "piIde.session.copyWorkspacePath",
          "when": "false"
        },
        {
          "command": "piIde.project.copyWorkspacePath",
          "when": "false"
        },
        {
          "command": "piIde.tab.copyWorkspacePath",
          "when": "false"
        },
        {
          "command": "piIde.tab.revealInSessions",
          "when": "false"
        },
        {
          "command": "piIde.tab.reloadPage",
          "when": "false"
        },
        {
          "command": "piIde.sessions.cycleViewMode",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "piIde.open",
          "group": "navigation@0",
          "when": "activeEditor == 'workbench.editors.files.textFileEditor'"
        },
        {
          "command": "piIde.openInBrowser",
          "group": "navigation@1",
          "when": "activeEditor =~ /piIde\\.webview/"
        }
      ],
      "editor/context": [
        {
          "command": "piIde.mentionSelection",
          "when": "editorHasSelection",
          "group": "piweb@1"
        },
        {
          "command": "piIde.mentionSelection",
          "when": "!editorHasSelection",
          "group": "piweb@1"
        }
      ],
      "explorer/context": [
        {
          "command": "piIde.mentionFile",
          "when": "explorerResourceIsFolder || explorerResourceIsFile",
          "group": "piweb@1"
        }
      ],
      "view/title": [
        {
          "command": "piIde.stop",
          "when": "view == 'piIde.webview' && piIde.serverRunning",
          "group": "navigation@2"
        },
        {
          "command": "piIde.sessions.newSession",
          "when": "view == 'piIde.sessions'",
          "group": "navigation@0"
        },
        {
          "command": "piIde.sessions.refresh",
          "when": "view == 'piIde.sessions'",
          "group": "navigation@1"
        },
        {
          "command": "piIde.sessions.filterWorkspace",
          "when": "view == 'piIde.sessions' && !piIde.sessions.workspaceOnly",
          "group": "navigation@1"
        },
        {
          "command": "piIde.sessions.showAll",
          "when": "view == 'piIde.sessions' && piIde.sessions.workspaceOnly",
          "group": "navigation@1"
        },
        {
          "command": "piIde.sessions.cycleViewMode",
          "when": "view == 'piIde.sessions'",
          "group": "sessions@0"
        },
        {
          "command": "piIde.openOriginal",
          "when": "view == 'piIde.sessions'",
          "group": "sessions@1"
        },
        {
          "command": "piIde.settings",
          "when": "view == 'piIde.sessions'",
          "group": "sessions@2"
        },
        {
          "command": "piIde.sessions.editProjectSettings",
          "when": "view == 'piIde.sessions'",
          "group": "sessions@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "piIde.tab.copyWorkspacePath",
          "when": "resourceFilename =~ /webview-.*piIde\\.webview/ || activeWebviewPanelId =~ /piIde\\.webview/ && !resourceSet",
          "group": "piweb@0"
        },
        {
          "command": "piIde.tab.revealInSessions",
          "when": "resourceFilename =~ /webview-.*piIde\\.webview\\.(s|n)/ || activeWebviewPanelId =~ /piIde\\.webview/ && !resourceSet",
          "group": "piweb@1"
        },
        {
          "command": "piIde.tab.reloadPage",
          "when": "resourceFilename =~ /webview-.*piIde\\.webview/ || activeWebviewPanelId =~ /piIde\\.webview/ && !resourceSet",
          "group": "piweb@2"
        }
      ],
      "view/item/context": [
        {
          "command": "piIde.session.openInWorkspaceWindow",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session.*\\.wsForeign/",
          "group": "inline@0"
        },
        {
          "command": "piIde.project.openInWindow",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.project.*\\.wsForeign/",
          "group": "inline@0"
        },
        {
          "command": "piIde.session.open",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session/",
          "group": "piweb@0"
        },
        {
          "command": "piIde.session.openFull",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session/",
          "group": "piweb@1"
        },
        {
          "command": "piIde.session.revealInExplorer",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session.*\\.wsSub/",
          "group": "piweb@2"
        },
        {
          "command": "piIde.session.openInNewWindow",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session.*\\.wsOther/",
          "group": "piweb@3"
        },
        {
          "command": "piIde.session.openInTerminal",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session.*\\.hasDir/",
          "group": "piweb@4"
        },
        {
          "command": "piIde.session.copyWorkspacePath",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session.*\\.hasDir/",
          "group": "piweb@5"
        },
        {
          "command": "piIde.session.rename",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session/",
          "group": "piweb.mod@0"
        },
        {
          "command": "piIde.session.fork",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session/",
          "group": "piweb.mod@1"
        },
        {
          "command": "piIde.session.pin",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session/ && !(viewItem =~ /\\.pinned/)",
          "group": "piweb.mod@2"
        },
        {
          "command": "piIde.session.unpin",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session.*\\.pinned/",
          "group": "piweb.mod@2"
        },
        {
          "command": "piIde.session.archive",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session/ && !(viewItem =~ /\\.archived/)",
          "group": "piweb.mod@3"
        },
        {
          "command": "piIde.session.unarchive",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session.*\\.archived/",
          "group": "piweb.mod@3"
        },
        {
          "command": "piIde.session.delete",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.session/",
          "group": "piweb.mod@4"
        },
        {
          "command": "piIde.project.newSession",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.project/",
          "group": "inline@0"
        },
        {
          "command": "piIde.project.rename",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.project/",
          "group": "piweb@1"
        },
        {
          "command": "piIde.project.pin",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.project/ && !(viewItem =~ /\\.pinned/)",
          "group": "piweb@2"
        },
        {
          "command": "piIde.project.unpin",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.project.*\\.pinned/",
          "group": "piweb@2"
        },
        {
          "command": "piIde.project.copyWorkspacePath",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.project/",
          "group": "piweb@3"
        },
        {
          "command": "piIde.sessions.editProjectSettingsHere",
          "when": "view == 'piIde.sessions' && viewItem =~ /piIde\\.project/",
          "group": "piweb@4"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test \"src/**/*.test.mjs\"",
    "test:e2e": "node --test --test-timeout=300000 \"e2e/*.test.mjs\"",
    "bump": "node scripts/bump-version.mjs",
    "package:pi-web": "node scripts/package-pi-web.js",
    "package": "vsce package --no-yarn --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "typescript": "^5.4.0"
  }
}

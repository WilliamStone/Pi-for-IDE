{
  "name": "pi-code",
  "displayName": "PI Code",
  "description": "PI Code — 基于 pi-web 构建的 VSCode 扩展，把 pi 编程智能体的 Web UI 封装为自包含的 webview 面板，在 VSCode 内与 AI 对话、浏览会话、配置模型/技能/插件，并集成文件审查、Diff、一键回退与当前文件上下文注入。",
  "version": "0.1.0",
  "publisher": "xiaowangwang",
  "license": "MIT",
  "icon": "resources/icons/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangjinxin613/pi-code.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "chat",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:piWeb.open",
    "onCommand:piWeb.start",
    "onCommand:piWeb.reveal",
    "onCommand:piWeb.mentionFile",
    "onCommand:piWeb.mentionSelection"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piWeb.open",
        "title": "打开 PI Code",
        "category": "PI Code",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piWeb.start",
        "title": "启动 PI Code 服务器",
        "category": "PI Code",
        "icon": "$(debug-start)"
      },
      {
        "command": "piWeb.reveal",
        "title": "显示 PI Code 面板",
        "category": "PI Code",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piWeb.stop",
        "title": "停止 PI Code 服务器",
        "category": "PI Code",
        "icon": "$(debug-stop)"
      },
      {
        "command": "piWeb.openInBrowser",
        "title": "在浏览器中打开 PI Code",
        "category": "PI Code",
        "icon": "$(globe)"
      },
      {
        "command": "piWeb.mentionFile",
        "title": "在 PI Code 中提及此文件",
        "category": "PI Code",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piWeb.mentionSelection",
        "title": "在 PI Code 中提及此代码",
        "category": "PI Code",
        "icon": "$(comment-discussion)"
      }
    ],
    "configuration": {
      "title": "PI Code",
      "properties": {
        "piWeb.executablePath": {
          "type": "string",
          "default": "",
          "description": "PI Code 底层运行 pi-web（@agegr/pi-web）作为 Web 服务器。此处可指定 pi-web 可执行文件（bin/pi-web.js）的绝对路径；留空则自动从 PATH 或工作区中查找。"
        },
        "piWeb.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "传给 pi-web 会话的项目目录（cwd）。留空则使用当前工作区文件夹。"
        },
        "piWeb.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "将 PI Code 面板打开在右侧（相邻分栏），而不是当前活动分栏。"
        },
        "piWeb.port": {
          "type": "number",
          "default": 3030,
          "minimum": 1,
          "maximum": 65535,
          "description": "PI Code 服务器起始端口（默认 3030）。该端口被占用时自动 +1 查找下一个空闲端口。"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "piWeb.open"
        },
        {
          "command": "piWeb.start"
        },
        {
          "command": "piWeb.stop"
        },
        {
          "command": "piWeb.reveal",
          "when": "false"
        },
        {
          "command": "piWeb.mentionFile",
          "when": "false"
        },
        {
          "command": "piWeb.mentionSelection",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "piWeb.open",
          "group": "navigation@0",
          "when": "activeEditor == 'workbench.editors.files.textFileEditor'"
        },
        {
          "command": "piWeb.openInBrowser",
          "group": "navigation@1",
          "when": "activeEditor == 'piWeb.webview'"
        }
      ],
      "editor/context": [
        {
          "command": "piWeb.mentionSelection",
          "when": "editorHasSelection",
          "group": "piweb@1"
        },
        {
          "command": "piWeb.mentionSelection",
          "when": "!editorHasSelection",
          "group": "piweb@1"
        }
      ],
      "explorer/context": [
        {
          "command": "piWeb.mentionFile",
          "when": "explorerResourceIsFolder || explorerResourceIsFile",
          "group": "piweb@1"
        }
      ],
      "view/title": [
        {
          "command": "piWeb.stop",
          "when": "view == 'piWeb.webview' && piWeb.serverRunning",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package:pi-web": "node scripts/package-pi-web.js",
    "package": "npm run package:pi-web && vsce package --no-yarn --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0"
  }
}

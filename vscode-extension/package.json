{
  "name": "pi-for-ide",
  "displayName": "pi for IDE",
  "description": "pi for IDE — VSCode-native editor experience for pi coding agent. Full pi-web GUI (chat, sessions, model/MCP config, themes, etc.) plus deep VSCode integration: @ file mentions, context-menu mentions, active-file context, per-turn file review cards with inline diffs and one-click revert, clipboard bridge, etc.",
  "version": "0.1.6",
  "publisher": "WilliamStone",
  "license": "MIT",
  "icon": "resources/icons/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WilliamStone/Pi-for-IDE.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "chat",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:piIde.open",
    "onCommand:piIde.start",
    "onCommand:piIde.reveal",
    "onCommand:piIde.mentionFile",
    "onCommand:piIde.mentionSelection"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piIde.open",
        "title": "打开",
        "category": "pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.start",
        "title": "启动服务器",
        "category": "pi for IDE",
        "icon": "$(debug-start)"
      },
      {
        "command": "piIde.reveal",
        "title": "显示面板",
        "category": "pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.stop",
        "title": "停止服务器",
        "category": "pi for IDE",
        "icon": "$(debug-stop)"
      },
      {
        "command": "piIde.openInBrowser",
        "title": "在浏览器中打开",
        "category": "pi for IDE",
        "icon": "$(globe)"
      },
      {
        "command": "piIde.mentionFile",
        "title": "提及此文件",
        "category": "pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.mentionSelection",
        "title": "提及此代码",
        "category": "pi for IDE",
        "icon": "$(comment-discussion)"
      }
    ],
    "configuration": {
      "title": "pi for IDE",
      "properties": {
        "piIde.executablePath": {
          "type": "string",
          "default": "",
          "description": "pi-web 服务器入口的绝对路径：standalone 产物的 server.js，或发行包的 bin/pi-web.js。留空则按顺序自动解析：扩展内置 → 全局 npm 安装 → npx 兜底。"
        },
        "piIde.package": {
          "type": "string",
          "default": "@william_stone/pi-web-for-ide",
          "description": "全局安装查询与 npx 兜底使用的 pi-web 发行包名（须为含 IDE 集成补丁的版本，而非原版 pi-web）。"
        },
        "piIde.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "传给 pi-web 会话的项目目录（cwd）。留空则使用当前工作区文件夹。"
        },
        "piIde.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "将 pi for IDE 面板打开在右侧（相邻分栏），而不是当前活动分栏。"
        },
        "piIde.port": {
          "type": "number",
          "default": 3030,
          "minimum": 1,
          "maximum": 65535,
          "description": "pi for IDE 服务器起始端口（默认 3030）。该端口被占用时自动 +1 查找下一个空闲端口。"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "piIde.open"
        },
        {
          "command": "piIde.start"
        },
        {
          "command": "piIde.stop"
        },
        {
          "command": "piIde.reveal",
          "when": "false"
        },
        {
          "command": "piIde.mentionFile",
          "when": "false"
        },
        {
          "command": "piIde.mentionSelection",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "piIde.open",
          "group": "navigation@0",
          "when": "activeEditor == 'workbench.editors.files.textFileEditor'"
        },
        {
          "command": "piIde.openInBrowser",
          "group": "navigation@1",
          "when": "activeEditor == 'piIde.webview'"
        }
      ],
      "editor/context": [
        {
          "command": "piIde.mentionSelection",
          "when": "editorHasSelection",
          "group": "piweb@1"
        },
        {
          "command": "piIde.mentionSelection",
          "when": "!editorHasSelection",
          "group": "piweb@1"
        }
      ],
      "explorer/context": [
        {
          "command": "piIde.mentionFile",
          "when": "explorerResourceIsFolder || explorerResourceIsFile",
          "group": "piweb@1"
        }
      ],
      "view/title": [
        {
          "command": "piIde.stop",
          "when": "view == 'piIde.webview' && piIde.serverRunning",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package:pi-web": "node scripts/package-pi-web.js",
    "package": "node scripts/sync-readme.js && vsce package --no-yarn --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0"
  }
}

{
  "name": "pi-for-ide",
  "displayName": "Pi for IDE",
  "description": "%description%",
  "version": "0.1.8",
  "publisher": "WilliamStone",
  "license": "MIT",
  "icon": "resources/icons/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WilliamStone/Pi-for-IDE.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "pi",
    "coding-agent",
    "ai",
    "chat",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:piIde.open",
    "onCommand:piIde.start",
    "onCommand:piIde.reveal",
    "onCommand:piIde.mentionFile",
    "onCommand:piIde.mentionSelection"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "piIde.open",
        "title": "%cmd.open%",
        "category": "Pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.start",
        "title": "%cmd.start%",
        "category": "Pi for IDE",
        "icon": "$(debug-start)"
      },
      {
        "command": "piIde.reveal",
        "title": "%cmd.reveal%",
        "category": "Pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.stop",
        "title": "%cmd.stop%",
        "category": "Pi for IDE",
        "icon": "$(debug-stop)"
      },
      {
        "command": "piIde.openInBrowser",
        "title": "%cmd.openInBrowser%",
        "category": "Pi for IDE",
        "icon": "$(globe)"
      },
      {
        "command": "piIde.mentionFile",
        "title": "%cmd.mentionFile%",
        "category": "Pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.mentionSelection",
        "title": "%cmd.mentionSelection%",
        "category": "Pi for IDE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piIde.upgrade",
        "title": "%cmd.upgrade%",
        "category": "Pi for IDE",
        "icon": "$(cloud-download)"
      },
      {
        "command": "piIde.versions",
        "title": "%cmd.versions%",
        "category": "Pi for IDE",
        "icon": "$(versions)"
      }
    ],
    "configuration": {
      "title": "Pi for IDE",
      "properties": {
        "Pi for IDE.executablePath": {
          "type": "string",
          "default": "",
          "description": "%config.executablePath%"
        },
        "Pi for IDE.package": {
          "type": "string",
          "default": "@william_stone/pi-web-for-ide",
          "description": "%config.package%"
        },
        "Pi for IDE.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "%config.workspaceRoot%"
        },
        "Pi for IDE.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "%config.openBeside%"
        },
        "Pi for IDE.port": {
          "type": "number",
          "default": 3030,
          "minimum": 1,
          "maximum": 65535,
          "description": "%config.port%"
        },
        "Pi for IDE.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoStart%"
        },
        "Pi for IDE.autoStop": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoStop%"
        },
        "Pi for IDE.autoStopAfterSec": {
          "type": "number",
          "default": 90,
          "minimum": 90,
          "description": "%config.autoStopAfterSec%"
        },
        "Pi for IDE.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "%config.checkForUpdates%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "piIde.open"
        },
        {
          "command": "piIde.start"
        },
        {
          "command": "piIde.stop"
        },
        {
          "command": "piIde.reveal",
          "when": "false"
        },
        {
          "command": "piIde.mentionFile",
          "when": "false"
        },
        {
          "command": "piIde.mentionSelection",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "piIde.open",
          "group": "navigation@0",
          "when": "activeEditor == 'workbench.editors.files.textFileEditor'"
        },
        {
          "command": "piIde.openInBrowser",
          "group": "navigation@1",
          "when": "activeEditor == 'piIde.webview'"
        }
      ],
      "editor/context": [
        {
          "command": "piIde.mentionSelection",
          "when": "editorHasSelection",
          "group": "piweb@1"
        },
        {
          "command": "piIde.mentionSelection",
          "when": "!editorHasSelection",
          "group": "piweb@1"
        }
      ],
      "explorer/context": [
        {
          "command": "piIde.mentionFile",
          "when": "explorerResourceIsFolder || explorerResourceIsFile",
          "group": "piweb@1"
        }
      ],
      "view/title": [
        {
          "command": "piIde.stop",
          "when": "view == 'piIde.webview' && piIde.serverRunning",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test \"src/**/*.test.mjs\"",
    "package:pi-web": "node scripts/package-pi-web.js",
    "package": "node scripts/sync-readme.js && vsce package --no-yarn --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0"
  }
}

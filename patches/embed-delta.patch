+test("PI_WEB_SHUTDOWN_DEADLINE_MS sets the deadline", async (t) => {
+  const previousValue = process.env.PI_WEB_SHUTDOWN_DEADLINE_MS;
+  process.env.PI_WEB_SHUTDOWN_DEADLINE_MS = "250";
+  try {

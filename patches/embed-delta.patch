+  writeChild("completed");
+
+  const originalListSessions = listSessions;
+  let row = scannedRow();
+  listSessions = async () => [row];
+  resetSessionListState();
+  t.after(() => {
+    listSessions = originalListSessions;
+    invalidateSessionPathCache(childId);
+    resetSessionListState();
+    rmSync(dir, { recursive: true, force: true });
+  });
+
+  assert.equal((await listAllSessions({ force: true }))[0].relation.status, "completed");
+  // The scanner keeps handing back the same row while the file's fingerprint
+  // holds, so a rebuild does not read the file again.
+  writeChild("failed");
+  assert.equal((await listAllSessions({ force: true }))[0].relation.status, "completed");
+  // A changed file comes back as a new row, which is read.
+  row = scannedRow();
+  assert.equal((await listAllSessions({ force: true }))[0].relation.status, "failed");
+});

+  const { isWindowsAbsolutePath } = await loadSubject();
+  assert.equal(isWindowsAbsolutePath("D:\\repo"), true);
+  assert.equal(isWindowsAbsolutePath("d:/repo"), true);
+  assert.equal(isWindowsAbsolutePath("\\\\server\\share"), true);
+  assert.equal(isWindowsAbsolutePath("relative/path"), false);
+});

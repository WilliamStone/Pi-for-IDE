+"use client";
+
+import { useEffect } from "react";
+import { isEmbedMode, onEmbedHostNotification } from "@/lib/embed/bridge";
+import { buildAtMentionText, buildFileLineMentionText } from "@/lib/file-fuzzy";
+import type { ChatInputHandle } from "../ChatInput";
+
+/**
+ * embed 模式：监听宿主推送的「提及」通知（如宿主右键菜单触发）。
+ * 仅向聊天输入框插入 @path 或 @path:start-end 行范围提及，不插入代码块。
+ */
+export function useMentionNotification(
+  chatInputRef: { current: ChatInputHandle | null } | undefined,
+): void {
+  useEffect(() => {
+    if (!isEmbedMode() || !chatInputRef) return;
+    const unsubscribe = onEmbedHostNotification((msg) => {
+      if (msg.kind !== "mention") return;
+      const p = msg.relativePath as string;
+      const start = msg.startLine as number | undefined;
+      const end = msg.endLine as number | undefined;
+      if (start != null && end != null) {
+        chatInputRef.current?.insertText(buildFileLineMentionText(p, start, end));
+      } else {
+        chatInputRef.current?.insertText(buildAtMentionText(p, false));
+      }
+    });
+    return unsubscribe;
+  }, [chatInputRef]);
+}
diff --git a/components/embed/useTurnRevert.ts b/components/embed/useTurnRevert.ts
new file mode 100644
index 0000000..23bc032
--- /dev/null
+++ b/components/embed/useTurnRevert.ts
@@ -0,0 +1,124 @@
+"use client";
+
+import { useCallback, useState } from "react";
+import { isEmbedMode, revertEditViaHost, revertFilesViaHost } from "@/lib/embed/bridge";
+import { extractFileChanges } from "@/lib/file-changes";
+import type { TurnSnapshotTracker } from "@/lib/embed/turn-snapshot";
+import { useI18n } from "@/hooks/useI18n";
+import type { AgentMessage } from "@/lib/types";
+import type { NoticeType } from "@/hooks/useAgentSession";
+
+export interface TurnRevertInfo {
+  canRevert: boolean;
+  onRevert: (entryId: string) => void;
+  reverting: boolean;
+}
+
+/**
+ * 回退某一轮：恢复该轮改动的代码 + 删除该轮会话记录，然后重新加载会话。
+ * 入口在用户消息左侧的回退按钮（embed/TurnRevertButton）。
+ * 仅 embed 模式可用（回退依赖宿主的快照/文件写能力）。
+ */
+export function useTurnRevert(opts: {
+  /** 当前会话 id 与 cwd（渲染期解析好的最新值）。 */
+  sessionId: string | undefined;
+  cwd: string | undefined;
+  entryIds: string[];
+  messages: AgentMessage[];
+  turnSnapshots: TurnSnapshotTracker;
+  sessionBusy: boolean;
+  /** 判定"轮边界"的消息类型锚点（上游 ChatWindow 的 isGroupAnchor）。 */
+  isTurnBoundary: (message: AgentMessage) => boolean;
+  addNotice?: (notice: { id?: string; message: string; type?: NoticeType }) => void;
+  loadSession: (sid: string) => Promise<unknown>;
+}): {
+  revertingTurnId: string | null;
+  handleRevertTurn: (userEntryId: string) => Promise<void>;
+  buildRevertInfo: (userIdx: number, endIdx: number) => TurnRevertInfo;
+} {
+  const { sessionId, cwd, entryIds, messages, turnSnapshots, sessionBusy, isTurnBoundary, addNotice, loadSession } = opts;
+  const { t } = useI18n();
+  const [revertingTurnId, setRevertingTurnId] = useState<string | null>(null);
+
+  const handleRevertTurn = useCallback(async (userEntryId: string) => {
+    if (revertingTurnId) return;
+    const sid = sessionId;
+    if (!sid || !cwd) {
+      addNotice?.({ type: "error", message: t("chat.revertFailed", { message: "缺少 session 或 cwd" }) });
+      return;
+    }
+    // 找该轮：entryIds 与 messages 平行，定位用户消息索引
+    const userIdx = entryIds.indexOf(userEntryId);
+    if (userIdx < 0) return;
+    let endIdx = userIdx + 1;
+    while (endIdx < messages.length && !isTurnBoundary(messages[endIdx])) endIdx += 1;
+    const turnMessages = messages.slice(userIdx, endIdx);
+    const turnChanges = extractFileChanges(turnMessages, cwd);
+    const turnId = turnSnapshots.turnIdForEntry(userEntryId);
+    // 该轮所有 entryId（含用户消息本身）→ 删除记录
+    const turnEntryIds = entryIds.slice(userIdx, endIdx).filter((e): e is string => !!e);
+
+    setRevertingTurnId(userEntryId);
+    try {
+      // 1) 恢复代码（纯前端，edit 反向 apply / write 走快照）
+      let okCount = 0;
+      const errs: string[] = [];
+      if (!isEmbedMode()) {
+        throw new Error(t("chat.revertWebModeUnsupported"));
+      }
+      for (const change of turnChanges) {
+        if (change.kind === "edit" && change.edits && change.edits.length > 0) {
+          const r = await revertEditViaHost(change.path, cwd, change.edits);
+          if (r.success) okCount++;
+          else errs.push(`${change.relativePath}: ${r.message ?? "失败"}`);
+        } else if (change.kind === "write") {
+          const r = await revertFilesViaHost(turnId, [change.path], cwd);
+          if (r.success) okCount++;
+          else errs.push(`${change.relativePath}: ${r.message ?? "失败"}`);
+        } else {
+          errs.push(`${change.relativePath}: 该类型不支持回退`);
+        }
+      }
+      // 2) 删除该轮会话记录
+      const delRes = await fetch(`/api/sessions/${encodeURIComponent(sid)}/revert-turn`, {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ entryIds: turnEntryIds }),
+      });
+      const delData = await delRes.json().catch(() => ({ error: "无法解析响应" })) as { error?: string };
+      if (!delRes.ok || delData.error) {
+        errs.push(`删除会话记录失败：${delData.error ?? `HTTP ${delRes.status}`}`);
+      }
+
+      if (errs.length === 0) {
+        addNotice?.({ type: "success", message: t("chat.revertSuccess", { count: okCount }) });
+        // 3) 重新加载会话（删除记录后文件变了）
+        await loadSession(sid);
+      } else {
+        addNotice?.({ type: "error", message: t("chat.revertFailed", { message: errs.join("; ") }) });
+      }
+    } catch (e) {
+      addNotice?.({ type: "error", message: t("chat.revertFailed", { message: String(e) }) });
+    } finally {
+      setRevertingTurnId(null);
+    }
+  }, [revertingTurnId, sessionId, cwd, entryIds, messages, isTurnBoundary, turnSnapshots, addNotice, t, loadSession]);
+
+  // 组装某轮的「回退」能力，用于用户消息左侧的回退按钮
+  const buildRevertInfo = useCallback(
+    (userIdx: number, endIdx: number): TurnRevertInfo => {
+      const userEntryId = entryIds[userIdx];
+      const turnChanges = extractFileChanges(messages.slice(userIdx, endIdx), cwd);
+      const hasChanges = turnChanges.some((c) => c.kind === "edit" || c.kind === "write");
+      const canRevert = !!userEntryId && hasChanges && !sessionBusy;
+      return {
+        canRevert,
+        onRevert: canRevert ? (entryId: string) => void handleRevertTurn(entryId) : () => {},
+        reverting: userEntryId === revertingTurnId,
+      };
+    },
+    [entryIds, messages, cwd, sessionBusy, handleRevertTurn, revertingTurnId],
+  );
+
+  return { revertingTurnId, handleRevertTurn, buildRevertInfo };
+}
diff --git a/components/enabled-models-helpers.ts b/components/enabled-models-helpers.ts
new file mode 100644
index 0000000..44b3361
--- /dev/null
+++ b/components/enabled-models-helpers.ts
@@ -0,0 +1,104 @@
+import type { EnabledModelsModelView, EnabledModelsProviderView, EnabledModelsView } from "@/lib/enabled-models";
+
+/** Rows shown for the current filter, matched on model name and id. */
+export function filterEnabledModels(
+  models: readonly EnabledModelsModelView[],
+  query: string,
+): EnabledModelsModelView[] {
+  const needle = query.trim().toLowerCase();
+  if (!needle) return [...models];
+  return models.filter((model) => (
+    model.id.toLowerCase().includes(needle) || model.name.toLowerCase().includes(needle)
+  ));
+}
+
+export interface EnabledModelsBulkActions {
+  /** References the "enable" action would send. */
+  enableRefs: string[];
+  /** References the "disable" action would send. */
+  disableRefs: string[];
+  canEnable: boolean;
+  canDisable: boolean;
+}
+
+/**
+ * Bulk actions for the rows currently shown.
+ *
+ * Mirrors the server guard: pi reads an empty scope as "no scope" and shows
+ * every model again, so the UI never offers a bulk disable that would switch
+ * off the last enabled model anywhere.
+ */
+export function enabledModelsBulkActions(
+  view: EnabledModelsView | null,
+  shown: readonly EnabledModelsModelView[],
+): EnabledModelsBulkActions {
+  const enableRefs = shown.filter((model) => !model.enabled).map((model) => model.ref);
+  const disableRefs = shown.filter((model) => model.enabled).map((model) => model.ref);
+  const editable = view?.editable === true;
+  return {
+    enableRefs,
+    disableRefs,
+    canEnable: editable && enableRefs.length > 0,
+    canDisable: editable && disableRefs.length > 0
+      && (view?.enabledTotal ?? 0) - disableRefs.length >= 1,
+  };
+}
+
+export interface EnabledModelsProviderToggle {
+  /** True when every model this provider offers is enabled. */
+  checked: boolean;
+  /** True when the switch cannot move in the direction it would go. */
+  blocked: boolean;
+  /** Why it cannot move, as a refusal key, or null while it can. */
+  reason: "last-model" | "project-scope" | null;
+}
+
+/**
+ * The single switch a models.json provider gets instead of per-model rows.
+ *
+ * Its two positions are "all of this provider's models" and "none of them",
+ * so it reads `checked` from the full count rather than from "any enabled":
+ * a partial selection left by the TUI or a hand-edited settings file shows as
+ * off, next to the `1/2 enabled` count, and one click completes it. Reading it
+ * the other way would make the partial state unreachable in both directions
+ * whenever the last-enabled-model guard blocks the way down.
+ */
+export function enabledModelsProviderToggle(
+  view: EnabledModelsView | null,
+  provider: EnabledModelsProviderView,
+): EnabledModelsProviderToggle {
+  const bulk = enabledModelsBulkActions(view, provider.models);
+  const checked = provider.models.length > 0 && provider.enabledCount === provider.models.length;
+  const blocked = checked ? !bulk.canDisable : !bulk.canEnable;
+  return {
+    checked,
+    blocked,
+    reason: !blocked ? null : view?.editable ? "last-model" : "project-scope",
+  };
+}
+
+/** True when switching this single model off would empty the scope. */
+export function isLastEnabledModel(
+  view: EnabledModelsView | null,
+  model: EnabledModelsModelView,
+): boolean {
+  return model.enabled && (view?.enabledTotal ?? 0) <= 1;
+}
+
+export function findProviderView(
+  view: EnabledModelsView | null,
+  providerId: string,
+): EnabledModelsProviderView | undefined {
+  return view?.providers.find((provider) => provider.id === providerId);
+}
+
+/** `12/40` style badge for a provider row, or null while nothing is scoped. */
+export function providerBadgeLabel(
+  view: EnabledModelsView | null,
+  providerId: string,
+): string | null {
+  if (!view || view.allEnabled) return null;
+  const provider = findProviderView(view, providerId);
+  if (!provider) return null;
+  return `${provider.enabledCount}/${provider.models.length}`;
+}

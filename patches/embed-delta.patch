+  const scopes: McpScope[] = hasProject ? ["project", "global"] : ["global"];
+  return scopes.map((scope) => {
+    const file = data.files.find((info) => info.scope === scope);
+    return {
+      scope,
+      ...(file ? { file } : {}),
+      servers: data.servers.filter((server) => server.scope === scope),
+    };
+  });

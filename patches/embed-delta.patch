+              )}
+          </ConfigDetailStack>
+        </ConfigDetail>
+      </ConfigSplitView>
+      <ConfigFooter status={(settingsError || error) && <span role="alert" style={{ color: "#ef4444" }}>{settingsError || error}</span>}>
+        {editing && (

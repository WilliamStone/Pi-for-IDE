+  let depth = 0;
+  for (const match of markup.slice(start).matchAll(/<span\b|<\/span>/g)) {
+    depth += match[0] === "</span>" ? -1 : 1;
+    if (depth === 0) return markup.slice(start, start + match.index + match[0].length);

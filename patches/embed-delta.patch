+  if (target instanceof Refusal) return target.response();
+  try {
+    const { value: [outcome], path } = await setMcpServersEnabled(
+      target,
+      [server.name],
+      enabled,
+      enabled ? webPasswordRefusal(internals) : undefined,
+    );
+    const refused = outcomeRefusal(outcome, path);

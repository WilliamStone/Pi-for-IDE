+  --session-tree-inset-right: max(0px, calc(6px - var(--session-tree-scrollbar, 0px)));
+  position: relative;
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow-x: hidden;
+  overflow-y: auto;
+  /* The scrollbar's room is kept while the list fits too, so rows do not
+     narrow when it starts to scroll. An overlay scrollbar reserves nothing. */
+  scrollbar-gutter: stable;
+  padding-bottom: 6px;
+  box-sizing: border-box;
+}
+
+/* Safari before 18.2 has no scrollbar-gutter: an always-present scrollbar
+   keeps the same room. Its track is transparent, and a subtle thumb shows only
+   while the list is active and overflows. */
+@supports not (scrollbar-gutter: stable) {
+  .session-tree-scroll {
+    overflow-y: scroll;
+  }
+}
+
+.session-tree-inner {
+  position: relative;
+}
+
+.session-tree-row {
+  position: absolute;
+  right: 0;
+  left: 0;
+  box-sizing: border-box;
+  display: flex;
+  align-items: center;
+  min-width: 0;
+}

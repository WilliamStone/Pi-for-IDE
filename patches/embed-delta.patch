+"use client";
+
+import { useState } from "react";
+import { useI18n } from "@/hooks/useI18n";
+
+/**
+ * 用户消息左侧的「回退此轮」按钮（hover 显示，固定宽度占位避免布局跳动）。
+ * 点击后先二次确认，确认后调 onRevert 执行回退。
+ */
+export function TurnRevertButton({
+  entryId,
+  reverting,
+  onRevert,
+  hovered,
+}: {
+  entryId: string;
+  reverting?: boolean;
+  onRevert: (entryId: string) => void;
+  hovered: boolean;
+}) {
+  const { t } = useI18n();
+  const [confirming, setConfirming] = useState(false);
+
+  return (
+    <div style={{
+      width: 72, flexShrink: 0,
+      display: "flex", flexDirection: "column", alignItems: "flex-start",
+      gap: 4, paddingBottom: 2,
+    }}>
+      {confirming ? (
+        <>
+          <span style={{ fontSize: 10, color: "var(--text-dim)", whiteSpace: "nowrap" }}>
+            {t("chat.revertConfirm")}
+          </span>
+          <span style={{ display: "flex", gap: 4 }}>
+            <button
+              onClick={() => {
+                setConfirming(false);
+                onRevert(entryId);
+              }}
+              disabled={reverting}
+              title={t("chat.revertConfirmYes")}
+              style={{
+                padding: "2px 7px", height: 20,
+                background: "var(--accent)", border: "none",
+                borderRadius: 4, color: "#fff",
+                cursor: reverting ? "not-allowed" : "pointer",
+                fontSize: 10, fontWeight: 500, whiteSpace: "nowrap",
+              }}
+            >{t("chat.revertConfirmYes")}</button>
+            <button
+              onClick={() => setConfirming(false)}
+              disabled={reverting}
+              title={t("chat.revertConfirmNo")}
+              style={{
+                padding: "2px 7px", height: 20,
+                background: "none", border: "1px solid var(--border)",
+                borderRadius: 4, color: "var(--text-muted)",
+                cursor: "pointer", fontSize: 10, whiteSpace: "nowrap",
+              }}
+            >{t("chat.revertConfirmNo")}</button>
+          </span>
+        </>
+      ) : (
+        <button
+          onClick={() => setConfirming(true)}
+          title={t("chat.revertTurnTitle")}
+          style={{
+            display: "flex", alignItems: "center", gap: 4,
+            padding: "3px 8px", height: 22,
+            background: "none", border: "none",
+            borderRadius: 5,
+            color: "var(--text-dim)",
+            cursor: "pointer", fontSize: 11, fontWeight: 400,
+            whiteSpace: "nowrap",
+            opacity: hovered ? 1 : 0,
+            transition: "opacity 0.12s",
+          }}
+          onMouseEnter={(e) => { e.currentTarget.style.color = "var(--accent)"; }}
+          onMouseLeave={(e) => { e.currentTarget.style.color = "var(--text-dim)"; }}
+        >
+          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round">
+            <polyline points="9 14 4 9 9 4" />
+            <path d="M20 20v-7a4 4 0 0 0-4-4H4" />
+          </svg>
+          {t("chat.revertTurn")}
+        </button>
+      )}
+    </div>
+  );
+}
diff --git a/components/embed/useActiveFile.ts b/components/embed/useActiveFile.ts
new file mode 100644
index 0000000..5386dc2
--- /dev/null
+++ b/components/embed/useActiveFile.ts
@@ -0,0 +1,42 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { isEmbedMode, getActiveEditorViaHost, onEmbedHostNotification } from "@/lib/embed/bridge";
+
+export interface ActiveFile {
+  /** 相对宿主工作区根目录的路径；无活动文件时为 null。 */
+  relativePath: string | null;
+  /** 绝对路径。 */
+  filePath: string | null;
+}
+
+/**
+ * 宿主当前活动编辑器文件。embed 模式下主动拉取一次初始状态，并监听宿主
+ * 推送的 activeEditorChanged 通知；非 embed 模式恒为 null。
+ */
+export function useActiveFile(): ActiveFile | null {
+  const [activeFile, setActiveFile] = useState<ActiveFile | null>(null);
+
+  useEffect(() => {
+    if (!isEmbedMode()) return;
+    let cancelled = false;
+    void getActiveEditorViaHost().then((active) => {
+      if (!cancelled) setActiveFile(active);
+    }).catch(() => {
+      if (!cancelled) setActiveFile({ relativePath: null, filePath: null });
+    });
+    const unsubscribe = onEmbedHostNotification((payload) => {
+      if (payload.kind !== "activeEditorChanged") return;
+      setActiveFile({
+        relativePath: (payload as { relativePath?: string | null }).relativePath ?? null,
+        filePath: (payload as { filePath?: string | null }).filePath ?? null,
+      });
+    });
+    return () => {
+      cancelled = true;
+      unsubscribe();
+    };
+  }, []);
+
+  return activeFile;
+}
diff --git a/components/embed/useEmbedAtCompletion.ts b/components/embed/useEmbedAtCompletion.ts
new file mode 100644
index 0000000..143976e
--- /dev/null
+++ b/components/embed/useEmbedAtCompletion.ts
@@ -0,0 +1,69 @@
+"use client";
+
+import { useEffect } from "react";
+import { isEmbedMode, sendEmbedRequest } from "@/lib/embed/bridge";
+import type { AtQueryMatch, FileIndexEntry } from "@/lib/file-fuzzy";
+
+export interface AtServerResult {
+  cwd: string;
+  query: string;
+  matches: FileIndexEntry[];
+}
+
+/**
+ * Embed mode: when the @ token is active, ask the embed host for file
+ * completions. The host ranks against its own file index (workspace
+ * + open editors) which is always current. Results replace local matches
+ * while the token is open; closing the token clears them.
+ *
+ * 非 embed 模式为空操作；宿主补全结果写入调用方的 atServerResult 状态，
+ * 由调用方决定如何与本地索引结果合并。
+ */
+export function useEmbedAtCompletion(opts: {
+  cwd: string | null | undefined;
+  atQuery: AtQueryMatch | null;
+  atQueryText: string | null;
+  atServerResult: AtServerResult | null;
+  setAtServerResult: (r: AtServerResult | null) => void;
+}): void {
+  const { cwd, atQuery, atQueryText, atServerResult, setAtServerResult } = opts;
+  const embedMode = isEmbedMode();
+
+  useEffect(() => {
+    const tokenActive = atQuery !== null;
+    if (!embedMode || !tokenActive || !cwd || atQueryText === null) {
+      if (embedMode && atServerResult !== null) setAtServerResult(null);
+      return;
+    }
+    const fetchCwd = cwd;
+    const query = atQueryText;
+    let cancelled = false;
+    const timer = setTimeout(() => {
+      sendEmbedRequest<{ matches?: Array<{ path: string; isDir: boolean }> }>(
+        { kind: "completeAt", cwd: fetchCwd, query },
+        4000,
+      )
+        .then((res) => {
+          if (cancelled) return;
+          const matches: FileIndexEntry[] = (res?.matches ?? []).map((m) => ({
+            path: m.path,
+            name: m.path.split("/").pop() ?? m.path,
+            isDir: m.isDir,
+          }));
+          setAtServerResult({ cwd: fetchCwd, query, matches });
+        })
+        .catch((err) => {
+          if (cancelled) return;
+          // Bridge failed (timeout / no workspace) — surface an empty result so
+          // the menu doesn't keep showing stale local matches.
+          console.warn("[pi-web] @-complete bridge failed:", err);
+          setAtServerResult({ cwd: fetchCwd, query, matches: [] });
+        });
+    }, 120);
+    return () => { cancelled = true; clearTimeout(timer); };
+    // NOTE: atServerResult is intentionally excluded from deps — including it
+    // would cause an infinite loop: response → setAtServerResult → effect
+    // re-runs → sends another request → response → …
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [embedMode, atQuery, atQueryText, cwd]);
+}
diff --git a/components/embed/useEmbedClipboardKeys.ts b/components/embed/useEmbedClipboardKeys.ts
new file mode 100644
index 0000000..1cb6712
--- /dev/null
+++ b/components/embed/useEmbedClipboardKeys.ts
@@ -0,0 +1,86 @@
+"use client";
+
+import { useCallback, type KeyboardEvent } from "react";
+import { isEmbedMode, clipboardReadViaHost, clipboardWriteViaHost } from "@/lib/embed/bridge";
+
+/**
+ * embed 模式下跨源 iframe 的 Cmd/Ctrl+C/V/X/A 默认行为可能被宿主的
+ * 命令层拦截，到不了 textarea。返回的 keydown 处理器在输入框的
+ * onKeyDown 最前面同步截住这些键：preventDefault 后用宿主剪贴板桥读写
+ * 系统剪贴板 + 手动操作 textarea 选区，绕过拦截。
+ *
+ * 返回 false 表示未处理该键，交给后续处理器。
+ */
+export function useEmbedClipboardKeys(opts: {
+  value: string;
+  setValue: (v: string) => void;
+  isComposingRef: { current: boolean };
+}): (e: KeyboardEvent<HTMLTextAreaElement>) => boolean {
+  const { value, setValue, isComposingRef } = opts;
+  const embedMode = isEmbedMode();
+  return useCallback(
+    (e: KeyboardEvent<HTMLTextAreaElement>): boolean => {
+      if (!embedMode) return false;
+      const meta = e.metaKey || e.ctrlKey;
+      if (!meta) return false;
+      const k = e.key.toLowerCase();
+      if (k !== "c" && k !== "v" && k !== "x" && k !== "a") return false;
+      const ta = e.currentTarget;
+      // 输入法组合中不拦截，避免打断中文输入。
+      if (isComposingRef.current || e.nativeEvent.isComposing || e.nativeEvent.keyCode === 229) return false;
+
+      // 同步截住：不让宿主命令层拿走这个键。
+      e.preventDefault();
+      e.stopPropagation();
+
+      const start = ta.selectionStart;
+      const end = ta.selectionEnd;
+      const selected = start !== null && end !== null ? value.slice(start, end) : "";
+
+      if (k === "a") {
+        ta.select();
+        return true;
+      }
+
+      // 复制 / 剪切：写选中文本到系统剪贴板，剪切还要删选中。
+      if (k === "c" || k === "x") {
+        if (selected) {
+          void clipboardWriteViaHost(selected).catch(() => {
+            try { void navigator.clipboard?.writeText(selected); } catch { /* ignore */ }
+          });
+          if (k === "x") {
+            const next = value.slice(0, start!) + value.slice(end!);
+            setValue(next);
+            requestAnimationFrame(() => {
+              ta.selectionStart = ta.selectionEnd = start!;
+            });
+          }
+        }
+        return true;
+      }
+
+      // 粘贴：从系统剪贴板读文本插入。fire-and-forget，preventDefault 已同步拦住默认行为。
+      void (async () => {
+        let text = "";
+        try {
+          text = await clipboardReadViaHost();
+        } catch {
+          try { text = await navigator.clipboard?.readText() ?? ""; } catch { /* ignore */ }
+        }
+        if (!text) return;
+        const s = start ?? value.length;
+        const en = end ?? value.length;
+        const next = value.slice(0, s) + text + value.slice(en);
+        setValue(next);
+        const caret = s + text.length;
+        requestAnimationFrame(() => {
+          ta.selectionStart = ta.selectionEnd = caret;
+          ta.style.height = "auto";
+          ta.style.height = `${Math.min(ta.scrollHeight, 200)}px`;
+        });
+      })();
+      return true;
+    },
+    [embedMode, value, setValue, isComposingRef],
+  );
+}

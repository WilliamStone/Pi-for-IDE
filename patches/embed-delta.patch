+test("stop sends SIGTERM and waits for the launcher to exit", async () => {
+  const signals = [];
+  let alive = true;
+  const code = await stopServer(record(3000, 42), {
+    platform: "linux",
+    kill: (pid, signal) => {
+      signals.push([pid, signal]);
+    },
+    isAlive: () => alive,

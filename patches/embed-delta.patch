+} = await jiti.import("./new-session-context.ts");
+
+const main = { path: "/work/app", branch: "main", isMain: true };
+const feature = { path: "/work/app-worktrees/feature", branch: "feature", isMain: false };
+const context = {
+  cwd: "/work/app",
+  project: { key: "app-key", root: "/work/app" },

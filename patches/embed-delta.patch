+    setDraft(editableProfile(profile));
+    setMode(isWritableScope(profile.scope) ? "edit" : "view");
+    if (isWritableScope(profile.scope)) setTargetScope(profile.scope);
+    setError(null);
+  };
+
+  const beginCreate = () => {

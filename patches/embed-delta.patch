+        }
+        .tool-definitions-sidebar {
+          border-right: 1px solid var(--border);
+          background: color-mix(in srgb, var(--bg-panel) 94%, var(--bg));
+        }
+        .tool-definitions-list,
+        .tool-definition-scroll {
+          min-height: 0;
+          flex: 1;
+          overflow: auto;
+        }
+        .tool-definitions-item {
+          display: flex;
+          width: 100%;

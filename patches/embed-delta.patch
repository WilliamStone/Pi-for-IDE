+      return;
+    }
+    const containerRect = scrollEl.getBoundingClientRect();
+    const assistantRect = assistantElement.getBoundingClientRect();
+    const targetTop = (
+      assistantRect.top
+      - containerRect.top
+      + scrollEl.scrollTop
+      - scrollEl.clientHeight * 0.3
+    );

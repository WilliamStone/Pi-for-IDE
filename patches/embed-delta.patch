+  ["x --env A='$'\"{B}\" -- node", ["x", "--env", "A=${B}", "--", "node"]],
+  ["x --env 'A=$$'B -- node", ["x", "--env", "A=$$B", "--", "node"]],
+  ["x --url https://example.com/mcp --header 'X='\"$\"'{T}'", ["x", "--url", "https://example.com/mcp", "--header", "X=${T}"]],

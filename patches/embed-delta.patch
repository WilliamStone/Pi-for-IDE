+      data: { version: 1, status, completedAt: "2026-01-01T00:00:01.000Z", result: "done" },
+    },
+  ].map((entry) => JSON.stringify(entry)).join("\n"));
+  const scannedRow = () => ({
+    path: filePath,
+    id: childId,
+    cwd: dir,
+    created: new Date("2026-01-01T00:00:00.000Z"),
+    modified: new Date("2026-01-01T00:00:01.000Z"),

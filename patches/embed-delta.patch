+  assert.deepEqual(contextForCwd(context, "/tmp/new").project, { key: "/tmp/new", root: "/tmp/new" });
+  assert.deepEqual(contextForCwd(null, "/tmp/new"), {
+    cwd: "/tmp/new",
+    project: { key: "/tmp/new", root: "/tmp/new" },

+    return 1;
+  }
+
+  const code = install(name, latest);
+  if (code === null) {
+    error(`Could not find npm. Run: ${manualCommand(name)}`);
+    return 1;
+  }
+  return code;
+}
+
+module.exports = { findNpmInvocation, getInstallKind, isNewerStableVersion, runUpdate };

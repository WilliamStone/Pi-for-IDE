+  const kind = getInstallKind({ name, pkgDir, npmRoot: getNpmRoot(), realpath });
+  if (kind === "npx") {
+    error(`This pi-web runs from the npx cache. Run \`npx ${name}@latest\` instead.`);
+    return 1;
+  }

+    const helper = join(root, directory, "spawn-helper");
+    const stat = statSync(helper, { throwIfNoEntry: false });
+    if (stat?.isFile() && (stat.mode & 0o111) !== 0o111) chmodSync(helper, stat.mode | 0o111);
+  }
+}

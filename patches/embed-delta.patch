+      timestamp: "2026-01-01T00:00:01.000Z",
+    },
+    {
+      type: "message",
+      id: "user-1",
+      parentId: "model-old",
+      timestamp: "2026-01-01T00:00:02.000Z",
+      message: { role: "user", content: "keep this conversation" },
+    },
+    {
+      type: "message",
+      id: "assistant-1",
+      parentId: "user-1",
+      timestamp: "2026-01-01T00:00:03.000Z",
+      message: {
+        role: "assistant",

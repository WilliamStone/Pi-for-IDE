+.session-tree-group:hover .session-tree-summary,
+.session-tree-group.is-active .session-tree-summary {
+  display: none;
+}
+
+.session-tree-group:has(:focus-visible) .session-tree-group-actions {
+  display: flex;
+}
+
+.session-tree-group:has(:focus-visible) .session-tree-summary {
+  display: none;
+}
+
+@supports not selector(:has(*)) {
+  .session-tree-session:focus-within .session-tree-action,
+  .session-tree-group:focus-within .session-tree-group-actions {
+    display: flex;
+  }
+
+  .session-tree-session:focus-within .session-tree-meta,
+  .session-tree-group:focus-within .session-tree-summary {
+    display: none;
+  }
+
+  .session-tree.is-mobile .session-tree-session:focus-within .session-tree-meta,
+  .session-tree-session.is-running:focus-within .session-tree-meta {
+    display: flex;
+  }
+
+  .session-tree.is-mobile .session-tree-group:focus-within .session-tree-summary {
+    display: flex;
+  }
+}
+
+.session-tree .session-tree-group-action {
+  display: flex;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  width: 22px;
+  height: 22px;
+  padding: 0;
+  border-radius: 6px;
+  color: var(--text-dim);
+}
+
+.session-tree .session-tree-group-action:hover,
+.session-tree .session-tree-group-action.is-active {
+  background: var(--bg-selected);
+  color: var(--text);
+}
+
+/* In the text column, with the session titles. */
+.session-tree-group-empty,
+.session-tree-more {
+  padding-left: calc(var(--session-tree-inset-left) + 20px);
+  color: var(--text-dim);
+  font-size: 11px;
+}
+
+/* "Show more · N" and, once more is shown, "Show less" side by side. A lone
+   button takes the whole row; on a narrow sidebar "show more" gives way so
+   "Show less" is never clipped. */
+.session-tree-more-toggle {
+  flex: 0 1 auto;
+  min-width: 0;
+  height: 100%;
+  padding: 0;
+  overflow: hidden;
+  font-size: 11px;
+  text-align: left;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.session-tree-more-toggle:only-child {
+  flex: 1;
+}
+
+.session-tree-more-toggle + .session-tree-more-toggle {
+  flex: none;
+  margin-left: 14px;
+}
+
+.session-tree-more-toggle:hover {
+  color: var(--text);
+}
+
+/* Footer links: open another project, the archive. Their 12px icons in the
+   chevron column, their labels in the text column. */
+.session-tree-footer {
+  right: var(--session-tree-inset-right);
+  left: var(--session-tree-inset-left);
+  align-items: stretch;
+}
+
+.session-tree-footer-button {
+  display: flex;
+  flex: 1;
+  align-items: center;
+  gap: 3px;
+  min-width: 0;
+  padding: 0 4px 0 5px;
+  border-radius: 7px;
+  color: var(--text-dim);
+  font-size: 12px;
+  text-align: left;
+}
+
+.session-tree-footer-button:hover {
+  background: var(--bg-hover);
+  color: var(--text-muted);
+}
+
+.session-tree-footer-label {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.session-tree-footer-chevron {
+  flex: none;
+}
+
+/* Archive view: one header per project above its archived sessions, a
+   project's name as the main tree's headers show it, in the text column (it
+   folds nothing, so no chevron). As tall as a group's header, but no spacer
+   row parts the projects, so the name sits at the bottom of its row, near
+   its own sessions, at any height (a phone's 44px too). */
+.session-tree-archive-group {
+  align-items: flex-end;
+  gap: 5px;
+  padding: 0 8px 3px calc(var(--session-tree-inset-left) + 20px);
+  color: var(--text-muted);
+  font-size: 12px;
+  white-space: nowrap;
+}
+
+.session-tree-archive-group-name {
+  min-width: 0;
+  overflow: hidden;
+  font-weight: 600;
+  text-overflow: ellipsis;
+}
+
+.session-tree-archive-group-count {
+  flex: none;
+  color: var(--text-dim);
+}
+
+/* Phone layout: 44px rows, a step larger type for titles and project names,
+   ⋯ and the group buttons always shown, no archive quick button. */
+.session-tree.is-mobile .session-tree-title,
+.session-tree.is-mobile .session-tree-group-toggle,
+.session-tree.is-mobile .session-tree-archive-group {
+  font-size: 13px;
+}
+
+.session-tree.is-mobile .session-tree-more-action {
+  display: flex;
+  width: 32px;
+  height: 32px;
+}
+
+.session-tree.is-mobile .session-tree-session:hover .session-tree-meta {
+  display: flex;
+}
+
+.session-tree.is-mobile .session-tree-session:has(:focus-visible) .session-tree-meta {
+  display: flex;
+}
+
+.session-tree.is-mobile .session-tree-group-actions {
+  display: flex;
+}
+
+.session-tree.is-mobile .session-tree-group .session-tree-summary {
+  display: flex;
+}
+
+.session-tree.is-mobile .session-tree-group-action {
+  width: 32px;
+  height: 32px;
+}
+
+/* Inputs are forced to 16px on phones (globals.css), so the field gets taller. */
+.session-tree.is-mobile .session-tree-rename {
+  height: 32px;
+}
+
+.session-tree.is-mobile .session-tree-confirm-delete,
+.session-tree.is-mobile .session-tree-confirm-cancel {
+  height: 32px;
+}
+
+/* Touch screens wider than a phone have no hover: keep ⋯ reachable. */
+@media (hover: none) {
+  .session-tree-more-action {
+    display: flex;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .session-tree-unread::after {
+    animation: none;
+  }
+
+  .session-tree-awaiting::after {
+    animation: none;
+  }
+
+  .session-tree-chevron {
+    transition: none;
+  }
+}
+
+/*
+ * Sidebar shell (components/SessionSidebar.tsx): header, the Sessions | Files
+ * tabs and their panels, or (.is-files-below, the desktop default) both
+ * panels in one column, the files under the sessions. Both panels stay
+ * mounted; an inactive tab has the hidden attribute (display: none from the
+ * base styles). The root is the containing block of the undo toast.
+ */
+.session-sidebar {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  min-height: 0;
+  overflow: hidden;
+}
+
+/* While the undo toast is up, the last rows can still scroll out from under it. */
+.session-sidebar.has-toast .session-tree-scroll {
+  padding-bottom: 56px;
+}
+
+/* With the files below, the toast sits at the bottom of the sessions, above
+   the files section (its height, or folded its 28px row and its line; 36px
+   on a coarse pointer, below), so it never covers the file tree. Still the
+   one live region, at the root. */
+.session-sidebar.is-files-below .sidebar-toast-region {
+  bottom: calc(var(--sidebar-files-height, 320px) + 8px);
+}
+
+.session-sidebar.is-files-below.is-files-collapsed .sidebar-toast-region {
+  bottom: 37px;
+}
+
+/* One toolbar row in the cells of the chat's top bar beside it (AppShell):
+   36px with its line, as that bar is, so the two read as one bar. Each cell is divided on its
+   right; the search cell's right is the sidebar's own edge. */
+.sidebar-header {
+  display: flex;
+  flex: none;
+  align-items: stretch;
+  height: 36px;
+  box-sizing: border-box;
+  border-bottom: 1px solid var(--border);
+}
+
+/* The tablist itself holds only the two tabs (ARIA allows nothing else in it). */
+.sidebar-tabs-list {
+  display: flex;
+  flex: none;
+  align-items: stretch;
+}
+
+/* The chat bar's cells: a 2px line on top that takes the accent when the
+   cell is the one chosen (a tab, the open search). */
+.sidebar-tab,
+.sidebar-new-button,
+.sidebar-search-toggle {
+  display: flex;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 0 12px;
+  border: 0;
+  border-top: 2px solid transparent;
+  border-radius: 0;
+  background: transparent;
+  color: var(--text-muted);
+  font-size: 12px;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background 0.12s, color 0.12s;
+}
+
+.sidebar-tab,
+.sidebar-new-button {
+  border-right: 1px solid var(--border);
+}
+
+/* New closes its own left side in both layouts, so New and the search read
+   as two cells, as the chat bar's right-end cell does: the brand before it
+   is no cell, and in the tabs layout the spacer leaves a gap after the last
+   tab at most widths. Its -1px margin lays that line over the last tab's
+   right one where the spacer has collapsed, and keeps New's footprint (and
+   so the fit levels) what it was without the line. */
+.sidebar-new-button {
+  margin-left: -1px;
+  border-left: 1px solid var(--border);
+}
+
+.sidebar-tab-icon {
+  flex: none;
+  color: var(--text-dim);
+}
+
+.sidebar-tab:hover,
+.sidebar-new-button:not(:disabled):hover,
+.sidebar-search-toggle:hover {
+  background: var(--bg-hover);
+  color: var(--text);
+}
+
+.sidebar-tab.is-selected,
+.sidebar-search-toggle.is-active {
+  border-top-color: var(--accent);
+  background: var(--bg-selected);
+  color: var(--text);
+}
+
+.sidebar-tab.is-selected {
+  font-weight: 500;
+}
+
+.sidebar-tab.is-selected .sidebar-tab-icon {
+  color: var(--accent);
+}
+
+.sidebar-tab-count {
+  color: var(--text-dim);
+  font-size: 10px;
+  font-variant-numeric: tabular-nums;
+  font-weight: 400;
+}
+
+/* With the files below the sessions there is no tab to choose: the brand
+   stands where the tabs were (PiWebTitle), the panel's typographic anchor,
+   as on the old sidebar. Not a cell: no box, no line on its right; its text
+   in the chevron column (6px in plus a header toggle's 5px). A click shows
+   the versions in the accent for a few seconds. Never cut: New's label
+   gives way first, and on a row too narrow for the versions they take the
+   sidebar's meta size (data-fit 2, which only they reach: "Pi Web" fits
+   beside the two cells at the sidebar's 180px minimum, and at 11px so do
+   the versions with a digit to spare). */
+.sidebar-brand {
+  flex: none;
+  align-self: center;
+  min-width: 6ch;
+  margin: 0 0 0 7px;
+  padding: 2px 4px;
+  border: 0;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--text);
+  font-family: var(--font-mono);
+  font-size: 15px;
+  font-weight: 700;
+  letter-spacing: -0.01em;
+  line-height: normal;
+  text-align: left;
+  white-space: nowrap;
+  cursor: default;
+}
+
+.sidebar-brand.is-version {
+  color: var(--accent);
+}
+
+.sidebar-brand:focus {
+  outline: none;
+}
+
+.sidebar-brand:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: 1px;
+}
+
+.sidebar-header-spacer {
+  flex: 1;
+  min-width: 0;
+}
+
+.sidebar-new-button {
+  font-weight: 500;
+}
+
+.sidebar-search-toggle {
+  width: 36px;
+  padding: 0;
+}
+
+.sidebar-new-button:disabled {
+  color: var(--text-dim);
+  cursor: not-allowed;
+}
+
+/* Where the labels do not fit (useHeaderFit measures them: their widths
+   change with the language): New keeps its + (data-fit 1), then the tabs
+   their icons, or the brand's versions take a smaller type (2). A hidden
+   label is still each one's name. */
+.sidebar-header[data-fit="1"] .sidebar-new-button,
+.sidebar-header[data-fit="2"] .sidebar-new-button {
+  width: 36px;
+  padding: 0;
+}
+
+.sidebar-header[data-fit="2"] .sidebar-tab {
+  padding: 0 11px;
+}
+
+.sidebar-header[data-fit="2"] .sidebar-brand {
+  font-size: 11px;
+}
+
+.sidebar-header[data-fit="1"] .sidebar-new-label,
+.sidebar-header[data-fit="2"] .sidebar-new-label,
+.sidebar-header[data-fit="2"] .sidebar-tab-label {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+.sidebar-new-button:focus-visible,
+.sidebar-search-toggle:focus-visible,
+.sidebar-tab:focus-visible,
+.sidebar-archive-back:focus-visible,
+.sidebar-tool-button:focus-visible,
+.sidebar-files-section-toggle:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: -2px;
+}
+
+.sidebar-panel {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  overflow: hidden;
+}
+
+/* The files below the sessions: the sessions fill what the files leave and
+   keep a few rows (SESSIONS_SECTION_MIN_HEIGHT in SessionSidebar.tsx); the
+   files section is as tall as the separator sets (--sidebar-files-height, on
+   the root), its top border the line between them. A sidebar too short for
+   both (a landscape phone, a short window) shrinks the files, never past
+   their header row: the sessions' zero basis freezes them at their minimum,
+   so the files take the whole shortfall and nothing runs past the root.
+   Folded, it is its header row alone (28px and its line, a height in pixels
+   so a fold can move to it), at the bottom, and the sessions take the
+   rest. */
+.session-sidebar.is-files-below .sidebar-sessions-panel {
+  flex-basis: 0;
+  min-height: 120px;
+}
+
+.session-sidebar.is-files-below .sidebar-files-panel {
+  flex: 0 1 auto;
+  height: var(--sidebar-files-height, 320px);
+  min-height: 29px;
+  border-top: 1px solid var(--border);
+}
+
+.session-sidebar.is-files-below.is-files-collapsed .sidebar-files-panel {
+  height: 29px;
+}
+
+/* A fold or an unfold (only those: .is-files-folding is on the root while
+   one runs, never for a drag, keys, a window resize or a layout switch)
+   moves the files' height between the separator's and the header row's,
+   the sessions growing or shrinking to match, and the toast above them
+   with it. The body shows from the start of an unfold and stays, inert,
+   to the end of a fold (SessionSidebar.tsx). */
+.session-sidebar.is-files-below.is-files-folding .sidebar-files-panel {
+  transition: height 180ms ease-out;
+}
+
+.session-sidebar.is-files-below.is-files-folding .sidebar-toast-region {
+  transition: bottom 180ms ease-out;
+}
+
+/* The separator between them: a 12px hit area centred on the files
+   section's top border, which is the line it shows; the sidebar's own
+   handle (app/globals.css, .panel-resize-handle) turned on its side, so
+   hover, focus and a drag look the same. */
+.panel-resize-handle.sidebar-files-resize-handle {
+  width: auto;
+  height: 12px;
+  margin: -6px 0;
+  flex: 0 0 12px;
+  cursor: row-resize;
+}
+
+.panel-resize-handle.sidebar-files-resize-handle::after {
+  top: 5px;
+  right: 0;
+  bottom: auto;
+  left: 0;
+  width: auto;
+  height: 2px;
+}
+
+/* Below the sessions, the files' right edge is the session times': a
+   session row ends 6px in, or on the session tree's classic scrollbar's
+   gutter where that is further in (SessionTree puts the gutter's width on
+   the root too), and its time 4px inside the row. The header row's keys and
+   the picker's boxes end there. */
+.session-sidebar.is-files-below {
+  --sidebar-files-inset-right: max(10px, calc(var(--session-tree-scrollbar, 0px) + 4px));
+}
+
+/* The files section's header row (files below the sessions only), one row
+   for the whole files chrome. A section header as the pinned section's is:
+   the chevron in the tree's chevron column (6px in, plus the toggle's 5px),
+   the label in small capitals in the text column, the changed files' count
+   after it (" · N", meta); the whole toggle folds the section. At the right
+   end, on the session times' edge, the files' keys in the files tab's
+   order, the search last: seven keys always there (disabled without a
+   folder), so no key ever moves. The toggle keeps its content (chevron,
+   label, count) and the keys share what it leaves, 18 to 26px each; only
+   with the keys at 18px does the toggle give way: its label first, then
+   the count, down to the chevron (17px). At the default 260px beside
+   Chromium's 10px scrollbar "文件 · 2" leaves the keys about 24px each and
+   "Files · 123" about 21px; from about 300px they are 26px; at the sidebar's
+   180px minimum (159px inside the row's padding) they are 18px and the
+   toggle keeps 31px. */
+.sidebar-files-section {
+  display: flex;
+  flex: none;
+  align-items: center;
+  gap: 2px;
+  height: 28px;
+  padding: 0 var(--sidebar-files-inset-right) 0 6px;
+}
+
+/* Its content is its basis, with 5px on either side (its hover box never
+   ends on the count, which never touches the first key), and it takes the
+   row's room beyond the keys' 26px, so the whole space up to them folds
+   the section. What does not fit goes whole, never cut: it wraps to a
+   second line, under the first (as tall as the row: the chevron's box is)
+   and clipped with the overflow. The count goes first, then the label. */
+.sidebar-files-section-toggle {
+  display: flex;
+  flex: 1 1 auto;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 3px;
+  min-width: 17px;
+  height: 100%;
+  padding: 0 5px;
+  overflow: hidden;
+  border: 0;
+  border-radius: 7px;
+  background: transparent;
+  color: var(--text-muted);
+  font: inherit;
+  font-size: 11px;
+  text-align: left;
+  white-space: nowrap;
+  cursor: pointer;
+}
+
+.sidebar-files-section-toggle:hover {
+  background: var(--bg-hover);
+  color: var(--text);
+}
+
+/* The toggle's first line is as tall as the row: the chevron's box is (its
+   12px icon drawn in the middle, turning there), so a label or count that
+   wraps lands under the row, out of view. */
+.sidebar-files-section-toggle > .session-tree-chevron {
+  height: 100%;
+}
+
+/* The pinned section's label, letter for letter (.session-tree-pinned-label). */
+.sidebar-files-section-label {
+  min-width: 0;
+  overflow: hidden;
+  font-weight: 600;
+  letter-spacing: 0.05em;
+  text-overflow: ellipsis;
+  text-transform: uppercase;
+}
+
+/* The changed files' count, as the pinned section's (.session-tree-pinned-count). */
+.sidebar-files-section-count {
+  flex: none;
+  color: var(--text-dim);
+  font-weight: 400;
+}
+
+/* The keys' group, right-aligned by the toggle before it: never under its
+   seven keys' minimum (no shrink from 7 x 18px), never over their maximum
+   (7 x 26px). Its grow factor, far above the toggle's, gives it the room
+   the toggle's content leaves until the keys reach 26px; the toggle gets
+   the rest (a fraction of a pixel until then). */
+.sidebar-files-keys {
+  display: flex;
+  flex: 1000 0 calc(7 * 18px);
+  align-items: center;
+  max-width: calc(7 * 26px);
+}
+
+/* The section's keys: the files tab's square keys, a step under the row's
+   height, sharing their group's width alike. */
+.sidebar-files-keys .sidebar-tool-button {
+  flex: 1 1 0;
+  min-width: 18px;
+  max-width: 26px;
+  height: 26px;
+  border-radius: 6px;
+}
+
+/* Under that row (or the whole files tab): the head, then the tree filling
+   the rest. Hidden while the section is folded, never unmounted. */
+.sidebar-files-body {
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+}
+
+.sidebar-search {
+  flex: none;
+  padding: 8px 8px 4px;
+}
+
+.sidebar-search-input {
+  display: block;
+  width: 100%;
+  min-width: 0;
+  height: 29px;
+  padding: 0 10px;
+  box-sizing: border-box;
+  border: 1px solid var(--border);
+  border-radius: 7px;
+  background: var(--bg);
+  color: var(--text);
+  font: inherit;
+  font-size: 12px;
+}
+
+.sidebar-search-input:focus {
+  outline: 2px solid var(--accent);
+}
+
+/* The tree and the archive view under the search, in one cell: the archive
+   slides in over the tree, which stays mounted under it (hidden once the
+   archive is in), and away again. SessionTree fills each. */
+.sidebar-sessions-views {
+  display: grid;
+  flex: 1 1 auto;
+  grid-template: minmax(0, 1fr) / minmax(0, 1fr);
+  min-width: 0;
+  min-height: 0;
+}
+
+.sidebar-sessions-view {
+  display: flex;
+  grid-area: 1 / 1;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+}
+
+/* Opaque, so the tree under it only shows through while it fades. Stacked
+   above it for good: the tree's rows are positioned, and an unpositioned view
+   paints its background before them. Only its animation (opacity, transform)
+   would lift it, so the frame its entrance ends in showed the tree's rows
+   over it until the tree was hidden. */
+.sidebar-archive-view {
+  position: relative;
+  z-index: 1;
+  background: var(--bg-panel);
+}
+
+/* In from the right over the tree; out to the right, the tree back under it.
+   Nothing in a view on its way out takes a click (it is inert too). */
+.sidebar-archive-view.is-entering {
+  animation: sidebar-archive-in 180ms ease-out;
+}
+
+.sidebar-archive-view.is-leaving {
+  animation: sidebar-archive-out 180ms ease-in forwards;
+  pointer-events: none;
+}
+
+@keyframes sidebar-archive-in {
+  from {
+    opacity: 0;
+    transform: translateX(14px);
+  }
+}
+
+@keyframes sidebar-archive-out {
+  to {
+    opacity: 0;
+    transform: translateX(14px);
+  }
+}
+
+.sidebar-archive-bar {
+  display: flex;
+  flex: none;
+  align-items: center;
+  height: 34px;
+  padding: 0 6px;
+  box-sizing: border-box;
+  border-bottom: 1px solid var(--border);
+}
+
+.sidebar-archive-back {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  height: 26px;
+  padding: 0 6px;
+  border: 0;
+  border-radius: 6px;
+  background: transparent;
+  color: var(--text-muted);
+  font-size: 12px;
+  font-weight: 500;
+  cursor: pointer;
+}
+
+.sidebar-archive-back:hover {
+  background: var(--bg-hover);
+  color: var(--text);
+}
+
+.sidebar-archive-count {
+  color: var(--text-dim);
+  font-weight: 400;
+}
+
+.sidebar-icon-back {
+  transform: rotate(180deg);
+}
+
+.sidebar-icon-down {
+  transform: rotate(90deg);
+}
+
+.sidebar-icon-up {
+  transform: rotate(-90deg);
+}
+
+/* Files tab: the folder in use (the stacked project picker's two boxes,
+   app/globals.css) and what is done with it, then a line and the tree. */
+.sidebar-files-head {
+  display: flex;
+  flex: none;
+  flex-direction: column;
+  padding: 10px 10px 4px;
+  border-bottom: 1px solid var(--border);
+}
+
+/* Below the sessions the head is the picker's one row (its keys are the
+   header row's): the paths start in the text column (15px, the box's 1px
+   line and its 10px: 26px), the boxes end on the keys' edge, and no line
+   parts it from the tree, whose first row starts 4px under the boxes (the
+   head's 2px, then the tree's own 2px; the scroll box adds none). An error
+   under them keeps that 4px and the boxes' edges. */
+.session-sidebar.is-files-below .sidebar-files-head {
+  padding: 2px var(--sidebar-files-inset-right) 2px 15px;
+  border-bottom: 0;
+}
+
+.session-sidebar.is-files-below .sidebar-files-scroll {
+  padding-top: 0;
+}
+
+.session-sidebar.is-files-below .sidebar-files-error {
+  padding: 2px var(--sidebar-files-inset-right) 4px 15px;
+}
+
+/* The head's last row: the actions on that folder and the tree's two
+   views, used often enough to stay in view (its search is the toolbar
+   row's). The folder's four from the left, the tree's views (ignored files,
+   changes) at the right end, the row's edges on the boxes'. Always the same
+   six (the changes view is disabled, not gone, without changes), so nothing
+   moves as the count flips. At the sidebar's 180px minimum they give way
+   together, down to 21px wide, and the gap before the views closes. */
+.sidebar-files-actions {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-top: 4px;
+}
+
+/* The first of the tree's views. A wrapper around the two would be sized
+   by their icons, not their 32px basis, and squeeze them at any width. */
+.sidebar-files-views-start {
+  margin-left: auto;
+}
+
+/* Square keys, borderless and dim: their box shows on hover. */
+.sidebar-tool-button {
+  display: flex;
+  flex: 0 1 32px;
+  align-items: center;
+  justify-content: center;
+  min-width: 21px;
+  height: 32px;
+  padding: 0;
+  border: 0;
+  border-radius: 7px;
+  background: transparent;
+  color: var(--text-dim);
+  cursor: pointer;
+  transition: color 0.12s, background 0.12s;
+}
+
+.sidebar-tool-button:not(:disabled):hover {
+  background: var(--bg-selected);
+  color: var(--text);
+}
+
+.sidebar-tool-button.is-active,
+.sidebar-tool-button.is-active:not(:disabled):hover {
+  background: var(--bg-selected);
+  color: var(--accent);
+}
+
+.sidebar-tool-button.is-done,
+.sidebar-tool-button.is-done:not(:disabled):hover {
+  background: transparent;
+  color: var(--accent);
+}
+
+.sidebar-tool-button:disabled {
+  cursor: default;
+  opacity: 0.6;
+}
+
+/* Under the head's line, on the boxes' edges. */
+.sidebar-files-error {
+  display: flex;
+  flex: none;
+  align-items: flex-start;
+  gap: 6px;
+  padding: 6px 10px 0;
+  color: #f87171;
+  font-size: 10px;
+  line-height: 1.35;
+}
+
+.sidebar-files-error-text {
+  flex: 1;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+/* The tree's first row 4px under the head's line (with the tree's own 2px),
+   as close as it sits under the boxes below the sessions. */
+.sidebar-files-scroll {
+  flex: 1 1 auto;
+  min-height: 0;
+  padding-top: 2px;
+  overflow-x: hidden;
+  overflow-y: auto;
+}
+
+@media (pointer: coarse) {
+  /* As tall as the picker's boxes there, still square. */
+  .sidebar-tool-button {
+    flex-basis: 36px;
+    height: 36px;
+  }
+
+  /* The files section's header row and its keys, for a finger; the folded
+     section and the toast above it follow its height. The keys come before
+     the label there: 32px, the toggle taking only what they leave (a zero
+     basis), down to its chevron, and only then do they narrow together
+     (to 15px; their group's basis is their width, its minimum zero). */
+  .sidebar-files-section {
+    height: 36px;
+  }
+
+  .sidebar-files-section-toggle {
+    flex: 1 1 0;
+  }
+
+  .sidebar-files-keys {
+    flex: 0 1 auto;
+    min-width: 0;
+    max-width: none;
+  }
+
+  .sidebar-files-keys .sidebar-tool-button {
+    flex: 0 1 32px;
+    width: 32px;
+    min-width: 15px;
+    max-width: none;
+    height: 32px;
+  }
+
+  .session-sidebar.is-files-below .sidebar-files-panel {
+    min-height: 37px;
+  }
+
+  .session-sidebar.is-files-below.is-files-collapsed .sidebar-files-panel {
+    height: 37px;
+  }
+
+  .session-sidebar.is-files-below.is-files-collapsed .sidebar-toast-region {
+    bottom: 45px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .sidebar-tab,
+  .sidebar-new-button,
+  .sidebar-search-toggle,
+  .sidebar-tool-button {
+    transition: none;
+  }
+
+  /* The fold and the archive view change at once (no phase starts either:
+     useSidebarMotion). */
+  .session-sidebar.is-files-below.is-files-folding .sidebar-files-panel,
+  .session-sidebar.is-files-below.is-files-folding .sidebar-toast-region {
+    transition: none;
+  }
+
+  .sidebar-archive-view.is-entering,
+  .sidebar-archive-view.is-leaving {
+    animation: none;
+  }
+}
diff --git a/bin/browser-opener.js b/bin/browser-opener.js
new file mode 100644
index 0000000..7e5c0a7
--- /dev/null
+++ b/bin/browser-opener.js
@@ -0,0 +1,34 @@
+"use strict";
+
+// eslint-disable-next-line @typescript-eslint/no-require-imports
+const { spawn } = require("child_process");
+
+function openInBrowser(url, platform = process.platform) {
+  // Avoid `shell: true` to suppress Node.js DEP0190 deprecation
+  // ("Passing args to a child process with shell option true can lead to
+  // security vulnerabilities, as the arguments are not escaped").
+  // Pass a structured argv so Node.js handles escaping instead of
+  // concatenating the args into a shell command string.
+  let opener;
+  if (platform === "win32") {
+    // `start` is a cmd.exe built-in, so invoke cmd directly. The empty
+    // title argument is required by `start` before the target URL.
+    opener = spawn(process.env.ComSpec || "cmd.exe", ["/c", "start", "", url], {
+      stdio: "ignore",
+      detached: true,
+    });
+  } else {
+    opener = spawn(platform === "darwin" ? "open" : "xdg-open", [url], {
+      stdio: "ignore",
+      detached: true,
+    });
+  }
+
+  opener.on("error", (error) => {
+    console.warn(`Could not open browser automatically: ${error.message}`);
+  });
+
+  opener.unref();
+}
+
+module.exports = { openInBrowser };
diff --git a/bin/pi-web-commands.js b/bin/pi-web-commands.js
new file mode 100644
index 0000000..3893d70
--- /dev/null
+++ b/bin/pi-web-commands.js
@@ -0,0 +1,129 @@
+"use strict";
+
+// eslint-disable-next-line @typescript-eslint/no-require-imports
+const { spawnSync } = require("child_process");
+// eslint-disable-next-line @typescript-eslint/no-require-imports
+const path = require("path");
+// eslint-disable-next-line @typescript-eslint/no-require-imports
+const { openInBrowser } = require("./browser-opener");
+// eslint-disable-next-line @typescript-eslint/no-require-imports
+const { runUpdate } = require("./pi-web-update");
+// eslint-disable-next-line @typescript-eslint/no-require-imports
+const { runUpdateSdk } = require("./pi-web-update-sdk");
+// eslint-disable-next-line @typescript-eslint/no-require-imports
+const records = require("./run-records");
+
+const STOP_TIMEOUT_MS = 10_000;
+const STOP_POLL_MS = 200;
+
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+function getPackageVersion(pkgDir = path.join(__dirname, "..")) {
+  // eslint-disable-next-line @typescript-eslint/no-require-imports
+  return require(path.join(pkgDir, "package.json")).version;
+}
+
+function killWindowsProcessTree(pid) {
+  const result = spawnSync("taskkill", ["/pid", String(pid), "/T", "/F"], { encoding: "utf8" });
+  if (result.error) throw result.error;
+  if (result.status !== 0) throw new Error((result.stderr || result.stdout || `taskkill exited ${result.status}`).trim());
+}
+
+async function stopServer(record, {
+  kill = process.kill,
+  killTree = killWindowsProcessTree,
+  platform = process.platform,
+  isAlive = records.isProcessAlive,
+  wait = sleep,
+  timeoutMs = STOP_TIMEOUT_MS,
+  log = console.log,
+  error = console.error,
+} = {}) {
+  // The launcher, or the Next.js server a killed launcher left serving.
+  const pid = record.stopPid ?? record.pid;
+  try {
+    // The launcher forwards SIGTERM to Next.js and exits after it. Windows has
+    // no SIGTERM: process.kill() would end the launcher alone and leave Next.js
+    // serving the port, so end the whole process tree there.
+    if (platform === "win32") killTree(pid);
+    else kill(pid, "SIGTERM");
+  } catch (killError) {
+    if (killError.code !== "ESRCH") {
+      error(`Could not stop pi-web (pid ${pid}): ${killError.message}`);
+      return 1;
+    }
+  }
+  for (let waited = 0; isAlive(pid); waited += STOP_POLL_MS) {
+    if (waited >= timeoutMs) {
+      error(`pi-web on ${record.url} (pid ${pid}) is still running after ${timeoutMs / 1000} s.`);
+      return 1;
+    }
+    await wait(STOP_POLL_MS);
+  }
+  log(`Stopped pi-web on ${record.url} (pid ${pid}).`);
+  return 0;
+}
+
+async function runCommand(options, {
+  runDir = records.getRunDir(),
+  pkgDir = path.join(__dirname, ".."),
+  open = openInBrowser,
+  isAnswering = records.isServerAnswering,
+  isOurs = records.isRecordProcess,
+  log = console.log,
+  error = console.error,
+} = {}) {
+  const list = () => records.listRunRecords(runDir, { isAnswering, isOurs });
+  switch (options.command) {
+    case "version":
+      log(getPackageVersion(pkgDir));
+      return 0;
+    case "status": {
+      const running = await list();
+      log(running.length === 0
+        ? "No pi-web server is running."
+        : `Running pi-web servers:\n${running.map(records.formatRunRecord).join("\n")}`);
+      return 0;
+    }
+    case "stop":
+    case "open": {
+      const selected = records.selectRunRecord(await list(), options.port);
+      if (!selected.record) {
+        error(selected.error);
+        return 1;
+      }
+      if (options.command === "stop") {
+        const code = await stopServer(selected.record, { log, error });
+        if (code === 0) records.removeRunRecord(runDir, selected.record.pid);
+        return code;
+      }
+      log(`Opening ${selected.record.url}`);
+      open(selected.record.url);
+      return 0;
+    }
+    case "update":
+      return runUpdate({
+        check: options.check,
+        currentVersion: getPackageVersion(pkgDir),
+        pkgDir,
+        listRecords: list,
+        formatRecord: records.formatRunRecord,
+        log,
+        error,
+      });
+    case "update-sdk": {
+      // A running server holds .next/ open; never rewrite its SDK underneath.
+      const running = await list();
+      if (running.length > 0) {
+        error(`pi-web is running:\n${running.map(records.formatRunRecord).join("\n")}\nRun \`pi-web stop\` first, then update the SDK.`);
+        return 1;
+      }
+      return runUpdateSdk(options.sdkVersion, { pkgDir, log, error });
+    }
+    default:
+      error(`Unknown command: ${options.command}`);
+      return 1;
+  }
+}
+
+module.exports = { getPackageVersion, runCommand, stopServer };

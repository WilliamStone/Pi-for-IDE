+
+const inputStyle: CSSProperties = {
+  width: "100%",
+  minWidth: 0,
+  height: 34,
+  padding: "0 9px",
+  border: "1px solid var(--border)",
+  borderRadius: 5,
+  background: "var(--bg)",
+  color: "var(--text)",

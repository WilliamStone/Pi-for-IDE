+  // The SDK hands an overridden server over as the global entry, naming the project file in `override`.
+  const ours = servers
+    .filter((server) => !server.invalidError && !server.shadowedByProject && !server.overriddenByProject)
+    .map((server) => [server.name, server.override
+      ? { source: globalSource, scope: "global", override: server.sourcePath, key: server.configKey, enabled: server.enabled }
+      : { source: server.sourcePath, scope: server.scope, key: server.configKey, enabled: server.enabled }])

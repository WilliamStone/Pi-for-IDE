+  let rawInput = "";
+  let bytes = 0;
+
+  for (let offset = 0; offset < totalLength; offset += chunkSize) {
+    const delta = "x".repeat(Math.min(chunkSize, totalLength - offset));
+    rawInput += delta;
+    const partial = {
+      ...assistantMessage(""),
+      content: [{

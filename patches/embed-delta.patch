+    else process.env.PI_WEB_SSE_BACKLOG_LIMIT_BYTES = previousLimit;
+  }
+});
+
+test("delivers every update to a client that reads promptly", async () => {
+  const { reader, listener, abortController } = await connectedStream("prompt-session");

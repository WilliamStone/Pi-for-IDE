+.session-tree button:focus,
+.session-tree a.session-tree-main:focus {
+  outline: none;
+}
+
+.session-tree button:focus-visible,
+.session-tree a.session-tree-main:focus-visible {
+  outline: 2px solid var(--accent);
+  outline-offset: -2px;
+}
+
+/*
+ * Two alignment lines run down the tree: a 12px chevron column (the rows'
+ * left inset plus a header toggle's 5px) and the text column 20px in from
+ * the inset (that 5px, the chevron's 12px, the toggle's 3px gap), where
+ * project names, section labels, session titles, "show more" and the
+ * footer's labels all start. Text takes three colors only: content
+ * (session titles) --text, labels (project names, section labels)
+ * --text-muted, meta (times, counts, branches, a pinned row's project)
+ * --text-dim. The accent is a state's, never a label's: the selected

+/* Session sidebar: tabs or the files below the sessions, project groups, session rows, files. */
+
+/*
+ * Session tree (components/SessionTree.tsx). Rows are absolutely positioned
+ * by the virtualizer, which also sets each row's height inline from
+ * SIDEBAR_ROW_HEIGHTS (lib/session-tree.ts), so no height is set here.
+ * `.session-tree.is-mobile` follows the component's layout prop (useIsMobile),
+ * not a media query, so the CSS always matches the heights the rows got.
+ */
+.session-tree {
+  /* The drag ghost's box: it sits outside the scroll box (SessionTree). */
+  position: relative;
+  display: flex;
+  flex: 1 1 auto;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+}
+
+.session-tree-message {
+  flex: none;
+  padding: 16px 14px;
+  color: var(--text-muted);
+  font-size: 12px;
+}
+
+.session-tree-message.is-error {
+  padding: 12px 14px;
+  color: #f87171;
+}
+
+.session-tree-scroll {
+  /* Rows sit 6px in from the left edge in every browser: the grid the brand,
+     the files section's header, the picker and the file tree keep too
+     (chevron column 11px in, text column 26px). A classic scrollbar takes
+     its width from the right only (--session-tree-scrollbar, measured in
+     SessionTree; Chromium's and Safari's styled one is 10px), so the right
+     inset shrinks by it: the rows end 6px in, or on the gutter's edge where
+     that is further in. */

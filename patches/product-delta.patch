++            relativePath: "",
++            toolName,
++            toolCallId: tc.toolCallId,
++            kind: "bash",
++            changeType: "unknown",
++            isError,
++          });
++        }
++      }
++      // 其他工具不产出文件改动条目
++    }
++  }
++
++  return orderedPaths.map((p) => byPath.get(p)!).filter(Boolean);
++}

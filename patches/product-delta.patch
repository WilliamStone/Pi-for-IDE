++            />
++          ))}
++          {hasBashUntracked && (
++            <div style={{
++              display: "flex", alignItems: "center", gap: 8,
++              padding: "6px 12px",
++              color: "var(--text-dim)", fontSize: 11, fontStyle: "italic",
++              borderTop: fileChanges.length > 0 ? "1px solid var(--border)" : "none",
++            }}>
++              <span>⚠</span>
++              <span>{t("chat.fileReviewBashUntracked")}</span>
++            </div>
++          )}

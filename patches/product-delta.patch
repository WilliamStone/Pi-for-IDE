+        </div>
+      </div>
+
+      <SidebarMenu
+        open={menu !== null}
+        anchor={menu?.anchor ?? null}
+        sheet={isMobile}
+        ariaLabel={menuLabel}
+        title={menuTitle}
+        items={menuItems}
+        cancelLabel={t("sidebar.cancel")}
+        focusCancel={menuBody !== null}
+        onClose={closeMenu}
+        returnFocusTo={menu?.opener ?? null}
+        width={menuWidth}
+      >
+        {menuBody}
+      </SidebarMenu>
+      <SidebarToast toast={toast} onDismiss={() => setToast(null)} dismissLabel={t("sidebar.dismiss")} />
     </div>
   );
 }

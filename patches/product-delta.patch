new file mode 100644
index 0000000..67f32cd
--- /dev/null
+++ b/vscode-extension/package.json
@@ -0,0 +1,195 @@
+{
+  "name": "pi-code-agent",
+  "displayName": "PI Code Agent",
+  "description": "PI Code Agent — 基于 pi-web 构建的 VSCode 扩展，把 pi 编程智能体的 Web UI 封装为自包含的 webview 面板，在 VSCode 内与 AI 对话、浏览会话、配置模型/技能/插件，并集成文件审查、Diff、一键回退与当前文件上下文注入。",
+  "version": "0.1.0",
+  "publisher": "xiaowangwang",
+  "license": "MIT",
+  "icon": "resources/icons/icon-128.png",
+  "repository": {
+    "type": "git",
+    "url": "https://github.com/wangjinxin613/pi-code.git"
+  },
+  "engines": {
+    "vscode": "^1.80.0"
+  },
+  "categories": [
+    "Other",
+    "Machine Learning",
+    "Chat"
+  ],
+  "keywords": [
+    "pi",
+    "coding-agent",
+    "ai",
+    "chat",
+    "agent"
+  ],
+  "activationEvents": [
+    "onStartupFinished",
+    "onCommand:piWeb.open",
+    "onCommand:piWeb.start",
+    "onCommand:piWeb.reveal",
+    "onCommand:piWeb.mentionFile",
+    "onCommand:piWeb.mentionSelection"
+  ],
+  "main": "./out/extension.js",
+  "contributes": {
+    "commands": [
+      {
+        "command": "piWeb.open",
+        "title": "打开 PI Code",
+        "category": "PI Code",
+        "icon": "$(comment-discussion)"
+      },
+      {
+        "command": "piWeb.start",
+        "title": "启动 PI Code 服务器",
+        "category": "PI Code",
+        "icon": "$(debug-start)"
+      },
+      {
+        "command": "piWeb.reveal",

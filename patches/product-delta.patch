++  /**
++   * session cwd → 最近3轮快照的内存表。快照只存「本轮前相对 HEAD 有
++   * 未提交改动的文件」的磁盘内容 + git 是否可用。超出3轮自动淘汰最老。
++   */
++  private readonly snapshots = new Map<string, TurnSnapshot[]>();
++  private static readonly MAX_TURNS = 3;

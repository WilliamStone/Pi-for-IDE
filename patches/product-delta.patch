--- /dev/null
+++ b/vscode-extension/src/extension.ts
@@ -0,0 +1,275 @@
+/**
+ * PI Code VSCode 扩展 — 主入口。
+ *
+ * PI Code 是 pi 编程智能体的独立 Next.js Web 界面。本扩展将这一 Web 界面托管
+ * 在 webview 内，并在后台启动一个本地 pi-web 服务器。除了文件浏览器之外，
+ * 其余体验与原版一致：会话浏览、聊天、模型/技能/插件配置、i18n 均照常工作；
+ * 打开文件、@ 补全等动作通过桥接转交给 VSCode 原生 API。
+ *
+ * 生命周期：
+ *  - activate：预热 pi-web 服务器、注册视图/命令。
+ *  - piWeb.start / piWeb.open：按需启动服务器，并在当前分栏或右侧（Beside）展示面板。
+ *  - piWeb.stop：终止服务器。
+ *  - webview.onDidReceiveMessage：把 openFile / completeAt / readFile / notify
+ *    请求从页面转交回 VSCode API，并返回结果。
+ *  - dispose：停止服务器并销毁 webview。
+ */
+
+import * as vscode from "vscode";
+import { PiWebServer } from "./piWebServer";
+import { PiWebWebviewPanel } from "./webviewProvider";
+import { Bridge, clearActiveEditorCache, resolveActiveEditor } from "./bridge";
+
+let server: Promise<PiWebServer | undefined>;
+let provider: PiWebWebviewPanel | undefined;
+let bridge: Bridge;
+let bridgeChannel: vscode.OutputChannel;
+let statusBarItem: vscode.StatusBarItem;
+
+export async function activate(context: vscode.ExtensionContext): Promise<void> {
+  bridgeChannel = vscode.window.createOutputChannel("PI Code 桥接");
+  context.subscriptions.push(bridgeChannel);
+  bridge = new Bridge((line) => bridgeChannel.appendLine(line));
+
+  // 状态栏图标 — 常驻可见，一键唤起聊天面板。
+  statusBarItem = vscode.window.createStatusBarItem(
+    vscode.StatusBarAlignment.Right,
+    100,
+  );
+  statusBarItem.text = "$(comment-discussion) PI Code";
+  statusBarItem.tooltip = "PI Code — 点击打开聊天面板";
+  statusBarItem.command = "piWeb.open";
+  statusBarItem.show();
+  context.subscriptions.push(statusBarItem);
+
+  // 保持「服务器运行中」上下文键同步，以便显示「停止」按钮。
+  const setRunningContext = (running: boolean) => {
+    vscode.commands.executeCommand("setContext", "piWeb.serverRunning", running);
+  };
+  setRunningContext(false);
+
+  // 懒启动服务器 — 仅在用户显式请求时启动。避免为只装了扩展但还没用的人
+  // 白白 spawn 一个 Next.js 进程。
+  const ensureServer = (): Promise<PiWebServer | undefined> => {
+    server = PiWebServer.ensureStarted(context).then((s) => {
+      setRunningContext(!!s);
+      if (s) {
+        statusBarItem.text = "$(comment-discussion) PI Code";
+        statusBarItem.backgroundColor = undefined;
+        statusBarItem.tooltip = `PI Code — 运行中，地址 ${s.origin}`;
+      }
+      return s;
+    }).catch((error) => {
+      console.error("[pi-web] 启动服务器失败:", error);
+      setRunningContext(false);
+      return undefined;
+    });
+    return server;
+  };
+
+  provider = new PiWebWebviewPanel(
+    context.extensionUri,
+    () => server,
+    () => ensureServer(),
+    bridge,
+  );
+
+  context.subscriptions.push(provider);
+
+  // -------------------------------------------------------------------------
+  // 命令
+  // -------------------------------------------------------------------------
+
+  context.subscriptions.push(
+    vscode.commands.registerCommand("piWeb.start", async () => {
+      const s = await ensureServer();
+      if (s) {
+        vscode.window.showInformationMessage(`PI Code 服务器已启动，地址 ${s.origin}`);
+      }
+    }),
+  );
+
+  context.subscriptions.push(
+    vscode.commands.registerCommand("piWeb.stop", async () => {
+      const s = await server;
+      if (s) {
+        await s.stop();
+        setRunningContext(false);
+        vscode.window.showInformationMessage("PI Code 服务器已停止。");
+      }
+    }),
+  );
+
+  // 主入口 — 在状态栏和命令面板中可见。按需启动服务器，并在右侧
+  // （Beside）展示面板。
+  context.subscriptions.push(
+    vscode.commands.registerCommand("piWeb.open", async () => {
+      const config = vscode.workspace.getConfiguration("piWeb");
+      const openBeside = config.get<boolean>("openBeside", true);
+      const viewColumn = openBeside
+        ? vscode.ViewColumn.Beside
+        : vscode.ViewColumn.Active;
+
+      // 解析 cwd：显式设置 > 工作区文件夹 > 弹窗选择。
+      let cwd = config.get<string>("workspaceRoot", "").trim();
+      if (!cwd) {
+        cwd = vscode.workspace.workspaceFolders?.[0]?.uri.fsPath ?? "";
+      }
+      if (!cwd) {
+        const picked = await vscode.window.showOpenDialog({
+          canSelectFiles: false,
+          canSelectFolders: true,
+          canSelectMany: false,
+          title: "PI Code：选择项目目录",
+        });
+        if (!picked || picked.length === 0) return;
+        cwd = picked[0].fsPath;
+      }
+
+      await ensureServer();
+      await provider!.reveal(cwd, viewColumn);
+    }),
+  );
+
+  // `piWeb.reveal` 仅聚焦已存在的面板（不触碰服务器）。
+  context.subscriptions.push(
+    vscode.commands.registerCommand("piWeb.reveal", () => {
+      provider!.focus();
+    }),
+  );
+
+  // 在系统默认浏览器中打开 PI Code（面板工具条按钮 / 命令面板 / 面板标题栏）。
+  context.subscriptions.push(
+    vscode.commands.registerCommand("piWeb.openInBrowser", async () => {
+      const s = await server;
+      if (s?.resolvedOrigin) {
+        await vscode.env.openExternal(vscode.Uri.parse(s.resolvedOrigin));
+      } else {
+        vscode.window.showWarningMessage("PI Code 服务器尚未启动，无法在浏览器中打开。");
+      }
+    }),
+  );
+
+  // ---------------------------------------------------------------------------
+  // 右键菜单：在 pi-web 聊天输入框中提及文件 / 选中的代码段
+  // ---------------------------------------------------------------------------
+
+  /**
+   * 从资源管理器/编辑器的上下文里解析出「相对于工作区的相对路径」。
+   * 支持多根工作区；不属任何工作区时返回 undefined。
+   */
+  function relativePathFor(uri: vscode.Uri): string | undefined {
+    const ws = vscode.workspace.getWorkspaceFolder(uri);
+    if (!ws) return undefined;
+    return vscode.workspace.asRelativePath(uri, false);
+  }
+
+  /**
+   * 触发一次提及：确保服务器和面板就绪，再把 payload 推给页面。
+   * 面板未打开时会先按 piWeb.open 的同样流程打开一次。
+   */
+  async function triggerMention(payload: {
+    relativePath: string;
+    startLine?: number;
+    endLine?: number;
+    selectedText?: string;
+  }): Promise<void> {
+    // 面板可能还没打开；先确保服务器就绪，再 reveal（用当前 cwd）。
+    const config = vscode.workspace.getConfiguration("piWeb");
+    const openBeside = config.get<boolean>("openBeside", true);
+    const viewColumn = openBeside
+      ? vscode.ViewColumn.Beside
+      : vscode.ViewColumn.Active;
+    let cwd = config.get<string>("workspaceRoot", "").trim();
+    if (!cwd) cwd = vscode.workspace.workspaceFolders?.[0]?.uri.fsPath ?? "";
+    if (!cwd) return; // 没有 cwd 时 pi-web 没法挂载会话，直接退出。
+
+    await ensureServer();
+    await provider!.reveal(cwd, viewColumn);
+    await provider!.pushMention(payload);
+  }
+
+  // 资源管理器 / 编辑器标题栏右键单个文件 -> 提及文件
+  context.subscriptions.push(
+    vscode.commands.registerCommand("piWeb.mentionFile", async (uri: vscode.Uri) => {
+      const relativePath = relativePathFor(uri);
+      if (!relativePath) {
+        vscode.window.showWarningMessage("PI Code：无法获取该文件相对工作区的路径。");
+        return;
+      }
+      await triggerMention({ relativePath });
+    }),
+  );
+
+  // 编辑器里选中文本后右键 -> 提及代码段
+  context.subscriptions.push(
+    vscode.commands.registerCommand("piWeb.mentionSelection", async () => {
+      const editor = vscode.window.activeTextEditor;
+      if (!editor) return;
+      const uri = editor.document.uri;
+      const relativePath = relativePathFor(uri);
+      if (!relativePath) {
+        vscode.window.showWarningMessage("PI Code：无法获取该文件相对工作区的路径。");
+        return;
+      }
+      const selection = editor.selection;
+      const selectedText = editor.document.getText(selection);
+      // 空选择时退化为整文件提及。
+      if (selection.isEmpty) {
+        await triggerMention({ relativePath });
+        return;
+      }
+      // 行号 1-based，闭区间。
+      const startLine = selection.start.line + 1;
+      const endLine = selection.end.line + 1;
+      // 末行如果选中到行首，实际不含该行，退化为上一行。
+      const adjustedEnd =
+        selection.end.character === 0 && endLine > startLine
+          ? endLine - 1
+          : endLine;
+      await triggerMention({
+        relativePath,
+        startLine,
+        endLine: adjustedEnd,
+        selectedText: selectedText || undefined,
+      });
+    }),
+  );
+
+  // -------------------------------------------------------------------------
+  // 当前活动编辑器文件 → 推送给 pi-web（用于隐藏 system prompt 上下文 + 输入框提示）
+  // -------------------------------------------------------------------------
+
+  /** 把当前活动编辑器文件推给 pi-web（面板未打开时为空操作，等面板刷新时同步）。 */
+  const pushActiveEditor = (): void => {
+    const active = resolveActiveEditor();
+    provider?.pushActiveEditor({
+      relativePath: active?.relativePath ?? null,
+      filePath: active?.filePath ?? null,
+    });
+  };
+
+  // 活动编辑器切换 / 编辑器打开关闭时同步
+  context.subscriptions.push(
+    vscode.window.onDidChangeActiveTextEditor(pushActiveEditor),
+  );
+  context.subscriptions.push(
+    vscode.workspace.onDidOpenTextDocument(() => {
+      // 刚打开的文件若成为活动编辑器也会触发 onDidChangeActiveTextEditor；
+      // 这里兜底，覆盖「非活动列打开文件」的场景。
+      setTimeout(pushActiveEditor, 0);
+    }),
+  );
+  context.subscriptions.push(
+    vscode.workspace.onDidCloseTextDocument((doc) => {
+      if (doc.uri.scheme !== "file") return;
+      clearActiveEditorCache(doc.uri.fsPath);
+      // 关闭后立即重新推送（可能因缓存失效变为 null，或回退到别的文件）。
+      setTimeout(pushActiveEditor, 0);
+    }),
+  );
+}
+
+export function deactivate(): void {
+  void server?.then((s) => s?.stop());
+}
diff --git a/vscode-extension/src/piWebServer.ts b/vscode-extension/src/piWebServer.ts
new file mode 100644
index 0000000..88df555
--- /dev/null
+++ b/vscode-extension/src/piWebServer.ts
@@ -0,0 +1,316 @@
+import * as cp from "child_process";
+import { existsSync } from "fs";
+import * as net from "net";
+import * as path from "path";
+import * as vscode from "vscode";
+
+/**
+ * 管理 pi-web 服务器的生命周期（独立进程）。
+ *
+ * pi-web 不打包进扩展，按以下顺序解析一个外部服务器入口：
+ *   1. `piWeb.executablePath` 配置（standalone 的 server.js 或包的 bin/pi-web.js）
+ *   2. 扩展内置的 `resources/pi-web/server.js`（过渡期兼容；打包停止内置后自然消失）
+ *   3. `npm root -g` 下已全局安装的 `piWeb.package`（默认 pi-code-web）
+ *   4. `npx -y <piWeb.package>` 兜底（首次联网下载，之后走缓存）
+ *
+ * 两种 spawn 模式：standalone server.js 只认 PORT/HOSTNAME 环境变量；
+ * bin 脚本接受 --port/--hostname/--no-open 参数。两者都把监听地址打印到
+ * stdout，统一用正则解析得到 origin。
+ *
+ * 服务器就绪后探测 `GET /api/embed`：返回 embed 协议标记说明是打过补丁的
+ * pi-code web；404/异常说明接入了原版 pi-web（VSCode 集成功能不可用，提示
+ * 用户更换安装源）。
+ */
+
+/** 默认起始端口：3030，被占用时自动 +1。 */
+export const DEFAULT_PORT = 3030;
+
+/**
+ * 默认查询/安装的 npm 包名（含 embed 桥补丁的 pi-web 发行包）。
+ * 可用 `piWeb.package` 配置覆盖；置空则跳过全局安装与 npx 兜底。
+ */
+const DEFAULT_PACKAGE = "pi-code-web";
+
+type SpawnTarget =
+  /** node <server.js>——standalone 产物，只认 PORT/HOSTNAME 环境变量。 */
+  | { mode: "script"; path: string }
+  /** node <bin/pi-web.js>——npm 包入口，接受 --port/--hostname/--no-open。 */
+  | { mode: "bin"; path: string }
+  /** npx -y <pkg>——兜底，首次运行联网下载。 */
+  | { mode: "npx"; pkg: string };
+
+/**
+ * 探测从 startPort 开始的第一个空闲 TCP 端口（每次 +1，最多尝试 200 个）。
+ */
+function findFreePort(startPort: number): Promise<number> {
+  return new Promise((resolve) => {
+    const tryPort = (port: number, attempts = 0): void => {
+      if (attempts >= 200) {
+        // 兜底：让 OS 分配端口，避免无限探测。
+        resolve(0);
+        return;
+      }
+      const tester = net.createServer();
+      tester.unref();
+      tester.once("error", () => {
+        try {
+          tester.close();
+        } catch {
+          // 未监听，忽略。
+        }
+        tryPort(port + 1, attempts + 1);
+      });
+      tester.listen(port, "127.0.0.1", () => {
+        tester.close(() => resolve(port));
+      });
+    };
+    tryPort(startPort);
+  });
+}
+
+/**
+ * 用 `npm root -g` 找全局 node_modules，返回其中 `<pkg>/bin/pi-web.js`
+ * 的绝对路径（不存在则 undefined）。npm 不在 PATH（如 nvm 未生效）时安静返回 undefined。
+ */
+function resolveGlobalPackageBin(pkg: string): Promise<string | undefined> {
+  return new Promise((resolve) => {
+    cp.exec("npm root -g", { timeout: 10_000 }, (err, stdout) => {
+      if (err) {
+        resolve(undefined);
+        return;
+      }
+      const binPath = path.join(stdout.trim(), pkg, "bin", "pi-web.js");
+      resolve(existsSync(binPath) ? binPath : undefined);
+    });
+  });
+}
+
+export class PiWebServer {
+  context: vscode.ExtensionContext;
+  child?: cp.ChildProcess;
+  ready: Promise<string | undefined>;
+  resolvedOrigin?: string;
+  channel: vscode.OutputChannel;
+  disposed = false;
+
+  static ensureStarted(context: vscode.ExtensionContext): Promise<PiWebServer | undefined> {
+    const existing = (globalThis as Record<string, unknown>).__piWebServer as PiWebServer | undefined;
+    if (existing) return Promise.resolve(existing);
+    const server = new PiWebServer(context);
+    (globalThis as Record<string, unknown>).__piWebServer = server;
+    return server.start();
+  }
+
+  constructor(context: vscode.ExtensionContext) {
+    this.context = context;
+    this.channel = vscode.window.createOutputChannel("PI Code");
+    this.context.subscriptions.push(this.channel);
+    this.ready = this.startProcess();
+    this.ready.then((origin) => {
+      if (origin) this.resolvedOrigin = origin;
+    });
+  }
+
+  /** 解析后的 origin（如 `http://127.0.0.1:39211`）。启动完成前为 undefined。 */
+  get origin(): string {
+    return this.resolvedOrigin ?? "http://127.0.0.1:0";
+  }
+
+  async start(): Promise<this | undefined> {
+    await this.ready;
+    return this.resolvedOrigin ? this : undefined;
+  }
+
+  async stop(): Promise<void> {
+    if (this.disposed) return;
+    this.disposed = true;
+    if (this.child && this.child.exitCode === null) {
+      try {
+        this.child.kill("SIGTERM");
+      } catch {
+        // 尽力关闭。
+      }
+    }
+  }
+
+  // ------------------------------------------------------------------
+  // 启动
+  // ------------------------------------------------------------------
+  /** 解析并启动 pi-web 服务器，返回解析后的 origin。 */
+  private async startProcess(): Promise<string | undefined> {
+    const target = await this.resolveServerTarget();
+    if (!target) {
+      const pkg = this.packageName();
+      this.channel.appendLine("未找到可用的 pi-web 服务器。");
+      void vscode.window.showErrorMessage(
+        `PI Code 找不到 pi-web 服务器。请全局安装含 IDE 集成的发行包（npm i -g ${pkg}），或设置 piWeb.executablePath 指向其入口文件。`,
+      );
+      return undefined;
+    }
+    const origin = await this.spawn(target);
+    if (origin) await this.verifyEmbedSupport(origin);
+    return origin;
+  }
+
+  private packageName(): string {
+    const config = vscode.workspace.getConfiguration("piWeb");
+    return (config.get<string>("package") ?? DEFAULT_PACKAGE).trim() || DEFAULT_PACKAGE;
+  }
+
+  /**
+   * 按优先级解析服务器入口：
+   *   executablePath → 内置 resources/pi-web/server.js → 全局 npm 包 → npx 兜底。
+   */
+  private async resolveServerTarget(): Promise<SpawnTarget | undefined> {
+    const config = vscode.workspace.getConfiguration("piWeb");
+
+    // 1) 显式配置：接受 standalone server.js 或包内 bin/pi-web.js。
+    const configured = config.get<string>("executablePath")?.trim();
+    if (configured) {
+      if (existsSync(configured)) {
+        const target: SpawnTarget = path.basename(configured) === "server.js"
+          ? { mode: "script", path: configured }
+          : { mode: "bin", path: configured };
+        this.channel.appendLine(`pi-web 入口（配置）: ${configured} [${target.mode}]`);
+        return target;
+      }
+      this.channel.appendLine(`piWeb.executablePath 不存在，忽略: ${configured}`);
+    }
+
+    // 2) 过渡期兼容：扩展内置的 standalone 产物（停止打包后该文件自然不存在）。
+    const bundled = path.join(this.context.extensionPath, "resources", "pi-web", "server.js");
+    if (existsSync(bundled)) {
+      this.channel.appendLine(`pi-web 入口（内置）: ${bundled}`);
+      return { mode: "script", path: bundled };
+    }
+
+    // 3) 全局 npm 安装的发行包。
+    const pkg = this.packageName();
+    const globalBin = await resolveGlobalPackageBin(pkg);
+    if (globalBin) {
+      this.channel.appendLine(`pi-web 入口（全局安装）: ${globalBin}`);
+      return { mode: "bin", path: globalBin };
+    }
+
+    // 4) npx 兜底：首次运行会联网下载，之后走 npx 缓存。
+    this.channel.appendLine(`pi-web 入口（npx）: ${pkg}`);
+    return { mode: "npx", pkg };
+  }
+
+  /** 探测空闲端口后按目标模式启动服务器，等待 stdout 打印的 URL。 */
+  private async spawn(target: SpawnTarget): Promise<string | undefined> {
+    // 读取用户配置的起始端口（默认 3030），探测第一个空闲端口。
+    const config = vscode.workspace.getConfiguration("piWeb");
+    const preferred =
+      typeof config.get<number>("port") === "number"
+        ? config.get<number>("port", DEFAULT_PORT)
+        : DEFAULT_PORT;
+    const port = await findFreePort(Math.max(1, preferred || DEFAULT_PORT));
+    this.channel.appendLine(
+      `PI Code 端口探测：起始 ${preferred}，使用 ${port}${port === 0 ? "（OS 分配）" : ""}`,
+    );
+
+    // 双轨参数：env 供 standalone server.js；args 供 bin/npx 模式。
+    const env: NodeJS.ProcessEnv = {
+      ...process.env,
+      PORT: String(port),
+      HOSTNAME: "127.0.0.1",
+      NODE_ENV: "production",
+      // bin 模式通过 PI_WEB_NO_OPEN 阻止 pi-web 自开浏览器（页面在扩展面板内）。
+      PI_WEB_NO_OPEN: "1",
+    };
+    const launchArgs = ["--port", String(port), "--hostname", "127.0.0.1", "--no-open"];
+
+    let command: string;
+    let args: string[];
+    let useShell = false;
+    switch (target.mode) {
+      case "script":
+        command = process.execPath;
+        args = [target.path];
+        break;
+      case "bin":
+        command = process.execPath;
+        args = [target.path, ...launchArgs];
+        break;
+      case "npx":
+        command = "npx";
+        args = ["-y", target.pkg, ...launchArgs];
+        // Windows 上 npx 是 .cmd shim，必须经 shell 启动。
+        useShell = process.platform === "win32";
+        this.channel.appendLine(`首次经 npx 启动需联网下载 ${target.pkg}，可能较慢。`);
+        break;
+    }
+
+    // npx 首次下载可能远超 30s，给更长超时。
+    const readyTimeoutMs = target.mode === "npx" ? 180_000 : 30_000;
+
+    return new Promise((resolve) => {
+      const child = cp.spawn(command, args, {
+        env,
+        stdio: ["ignore", "pipe", "pipe"],
+        shell: useShell,
+      });
+      this.child = child;
+      const onLine = (line: string) => {
+        this.channel.appendLine(line);
+        // Next 启动会打印类似 `- Local: http://localhost:39211`，也可能
+        // 打印 127.0.0.1。两种都识别。
+        const match = line.match(/https?:\/\/(127\.0\.0\.1|localhost):\d+/);
+        if (match) {
+          // 归一化成 127.0.0.1，避免 localhost 在严格 CSP 下出问题。
+          const origin = match[0].replace("localhost", "127.0.0.1");
+          resolve(origin);
+        }
+      };
+      let stdoutBuf = "";
+      child.stdout?.on("data", (chunk: Buffer) => {
+        stdoutBuf += chunk.toString();
+        let idx;
+        while ((idx = stdoutBuf.indexOf("\n")) >= 0) {
+          onLine(stdoutBuf.slice(0, idx));
+          stdoutBuf = stdoutBuf.slice(idx + 1);
+        }
+      });
+      child.stderr?.on("data", (chunk: Buffer) => {
+        this.channel.appendLine(chunk.toString());
+      });
+      child.on("error", (err) => {
+        this.channel.appendLine(`PI Code 进程启动失败：${err.message}`);
+        if (this.resolvedOrigin === undefined) resolve(undefined);
+      });
+      child.on("exit", (code) => {
+        this.channel.appendLine(`PI Code 进程退出，退出码 ${code}`);
+        if (this.resolvedOrigin === undefined) resolve(undefined);
+      });
+      setTimeout(() => {
+        if (this.resolvedOrigin === undefined) {
+          this.channel.appendLine(`PI Code 启动超时（${readyTimeoutMs / 1000}s）。`);
+          resolve(undefined);
+        }
+      }, readyTimeoutMs);
+    });
+  }
+
+  /**
+   * 探测服务器的 embed 协议支持（GET /api/embed）。返回 404/异常说明接入的
+   * 是原版 pi-web——VSCode 集成功能不可用，提示用户更换含补丁的发行包。
+   * 非阻断：页面仍可浏览会话。
+   */
+  private async verifyEmbedSupport(origin: string): Promise<void> {
+    try {
+      const res = await fetch(`${origin}/api/embed`, { signal: AbortSignal.timeout(3000) });
+      const data = (await res.json().catch(() => null)) as { embed?: { protocol?: number } } | null;
+      if (res.ok && data?.embed?.protocol) {
+        this.channel.appendLine(`embed 协议握手成功：protocol v${data.embed.protocol}`);
+        return;
+      }
+      throw new Error(`unexpected response: HTTP ${res.status}`);
+    } catch (e) {
+      this.channel.appendLine(`警告：/api/embed 探测失败（${String(e)}）——所连 pi-web 可能未包含 embed 桥补丁。`);
+      void vscode.window.showWarningMessage(
+        `PI Code：所连接的 pi-web 缺少 IDE 集成功能（疑似原版 pi-web）。请安装含补丁的发行包：npm i -g ${this.packageName()}。`,
+      );
+    }
+  }
+}
diff --git a/vscode-extension/src/webviewProvider.ts b/vscode-extension/src/webviewProvider.ts
